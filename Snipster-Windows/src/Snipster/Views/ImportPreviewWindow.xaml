<Window x:Class="Snipster.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Import" Height="420" Width="560"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="This file will add the following snippets. Review the content before importing — a snippet's replacement text is typed wherever you're working, so make sure nothing here looks unexpected."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="ImportButton" Content="Import" Width="80" Click="Import_Click" IsDefault="True"/>
        </StackPanel>

        <ListView x:Name="PreviewList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Trigger" Width="100" DisplayMemberBinding="{Binding Trigger}"/>
                    <GridViewColumn Header="Content" Width="400" DisplayMemberBinding="{Binding ContentPreview}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
