<Window x:Class="Snipster.Views.SnippetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Snippets" Height="440" Width="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="New" Width="60" Margin="0,0,6,0" Click="New_Click"/>
                <Button Content="Delete" Width="60" Click="Delete_Click"/>
            </StackPanel>
            <ListBox x:Name="SnippetList" DisplayMemberPath="Trigger"
                     SelectionChanged="SnippetList_SelectionChanged"/>
        </DockPanel>

        <StackPanel Grid.Column="2" x:Name="EditorPanel" IsEnabled="False">
            <TextBlock Text="Trigger"/>
            <TextBox x:Name="TriggerBox" Margin="0,2,0,10"/>

            <TextBlock Text="Content"/>
            <TextBox x:Name="ContentBox" Margin="0,2,0,10" Height="140"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Tag (optional — expansion works with no tag)"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                <ComboBox x:Name="TagBox" Width="200" DisplayMemberPath="Name"/>
                <Button Content="Manage Tags..." Margin="8,0,0,0" Click="ManageTags_Click"/>
            </StackPanel>

            <TextBlock x:Name="ValidationLabel" Foreground="Red" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,10"/>

            <Button Content="Save" Width="80" HorizontalAlignment="Right" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
