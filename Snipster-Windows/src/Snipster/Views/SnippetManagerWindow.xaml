<Window x:Class="Snipster.Views.SnippetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Snipster.Views"
        Title="Manage Snippets" Height="440" Width="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:GroupExpandedConverter x:Key="GroupExpandedConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="New" Width="60" Margin="0,0,6,0" Click="New_Click"/>
                <Button Content="Delete" Width="60" Click="Delete_Click"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <CheckBox x:Name="GroupByTagBox" Content="Group by tag"
                          Checked="GroupByTag_Changed" Unchecked="GroupByTag_Changed"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="ExpandAllButton" Content="Expand All" Width="103" Margin="0,0,6,0"
                            IsEnabled="False" Click="ExpandAll_Click"/>
                    <Button x:Name="CollapseAllButton" Content="Collapse All" Width="103"
                            IsEnabled="False" Click="CollapseAll_Click"/>
                </StackPanel>
            </StackPanel>

            <ListBox x:Name="SnippetList" SelectionChanged="SnippetList_SelectionChanged">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <!-- Expander supplies the disclosure triangle for free;
                                                 collapsing it hides that whole tag's ItemsPresenter. -->
                                            <Expander Margin="0,6,0,0"
                                                      IsExpanded="{Binding Name, Mode=OneWay, Converter={StaticResource GroupExpandedConverter}}"
                                                      Expanded="TagGroupExpander_Toggled"
                                                      Collapsed="TagGroupExpander_Toggled">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="Gray"/>
                                                </Expander.Header>
                                                <ItemsPresenter Margin="16,2,0,0"/>
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                     VerticalAlignment="Center" Fill="{Binding TagColorBrush}"/>
                            <TextBlock Text="{Binding Trigger}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <StackPanel Grid.Column="2" x:Name="EditorPanel" IsEnabled="False">
            <TextBlock Text="Trigger"/>
            <TextBox x:Name="TriggerBox" Margin="0,2,0,10"/>

            <TextBlock Text="Content"/>
            <TextBox x:Name="ContentBox" Margin="0,2,0,10" Height="140"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Tag (optional — expansion works with no tag)"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                <ComboBox x:Name="TagBox" Width="200" DisplayMemberPath="Name"/>
                <Button Content="Manage Tags..." Margin="8,0,0,0" Click="ManageTags_Click"/>
            </StackPanel>

            <TextBlock x:Name="ValidationLabel" Foreground="Red" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,10"/>

            <Button Content="Save" Width="80" HorizontalAlignment="Right" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
