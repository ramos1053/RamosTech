<Window x:Class="Snipster.Views.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Quick Access Hotkey" SizeToContent="WidthAndHeight"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Focusable="True" KeyDown="Window_KeyDown">
    <StackPanel Margin="16" Width="320">
        <TextBlock Text="Press the new key combination:" Margin="0,0,0,8"/>
        <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Background="#F5F5F5">
            <TextBlock x:Name="CaptureLabel" Text="(waiting for keys...)"
                       FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="ErrorLabel" Foreground="Red" Margin="0,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="70" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="ApplyButton" Content="Apply" Width="70" Click="Apply_Click" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
