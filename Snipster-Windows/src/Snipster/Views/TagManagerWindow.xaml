<Window x:Class="Snipster.Views.TagManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Tags" Height="360" Width="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="New" Width="60" Margin="0,0,6,0" Click="New_Click"/>
                <Button Content="Delete" Width="60" Click="Delete_Click"/>
            </StackPanel>
            <ListBox x:Name="TagList" SelectionChanged="TagList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <Rectangle Width="12" Height="12" Fill="{Binding SwatchBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding SnippetCountLabel}" Foreground="Gray" Margin="4,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <StackPanel Grid.Column="2" x:Name="EditorPanel" IsEnabled="False">
            <TextBlock Text="Name"/>
            <TextBox x:Name="NameBox" Margin="0,2,0,10"/>

            <TextBlock Text="Color"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                <Button Width="32" Height="32" Padding="0" Click="ChooseColor_Click"
                        ToolTip="Choose a color">
                    <Rectangle x:Name="ColorPreview" Width="24" Height="24"
                               Stroke="Gray" StrokeThickness="1"/>
                </Button>
                <TextBox x:Name="ColorBox" Width="90" Margin="8,0,0,0"
                         VerticalAlignment="Center" TextChanged="ColorBox_TextChanged"
                         ToolTip="Hex code, for anyone who prefers typing it directly"/>
            </StackPanel>

            <TextBlock x:Name="ValidationLabel" Foreground="Red" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,10"/>

            <Button Content="Save" Width="80" HorizontalAlignment="Right" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
