<Window x:Class="Snipster.Views.TemplateInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fill in template" SizeToContent="WidthAndHeight"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Topmost="True"
        ShowInTaskbar="False" KeyDown="Window_KeyDown">
    <!-- One row per {{INPUT:label}} token is inserted above the button row
         in code-behind, since the set of fields is only known at runtime. -->
    <StackPanel Margin="12" x:Name="RootPanel" MinWidth="280">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="70" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Insert" Width="70" Click="Insert_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
