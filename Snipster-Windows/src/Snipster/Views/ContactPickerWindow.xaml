<Window x:Class="Snipster.Views.ContactPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a contact" Width="260" Height="300"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="70" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Select" Width="70" Click="Select_Click" IsDefault="True"/>
        </StackPanel>
        <ListBox x:Name="ContactsList" DisplayMemberPath="Name"
                 MouseDoubleClick="ContactsList_MouseDoubleClick"/>
    </DockPanel>
</Window>
