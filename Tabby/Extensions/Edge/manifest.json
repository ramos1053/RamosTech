{
  "manifest_version": 3,
  "name": "Tabby - Tab Enumerator",
  "version": "1.0.0",
  "description": "Enumerates open tabs and sends them to the Tabby macOS app for Mission Control display.",
  "key": "",
  "permissions": [
    "tabs",
    "activeTab",
    "nativeMessaging",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "110"
}
