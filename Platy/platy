                if not fpath.exists():
                    print_err(f"file not found: {fpath}")
                else:
                    import difflib as _dl
                    a = fpath.read_text().splitlines(keepends=True)
                    b = script.splitlines(keepends=True)
                    diff = list(_dl.unified_diff(a, b,
                                fromfile=str(fpath), tofile="AI script"))
                    if not diff:
                        print_ok("no differences")
                    else:
                        for line in diff:
                            line = line.rstrip("\n")
