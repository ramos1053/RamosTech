        elif user_input == "/sessions":
            loaded_name, loaded_msgs = session_manager(stdscr)
            _ui.redraw()
            if loaded_name:
                sess_name      = loaded_name
                _platy_session = sess_name
                sess_path = SESS_DIR / f"{sess_name}.jsonl"
                messages  = ([{"role": "system", "content": SYSTEM_PROMPT}]
                             + loaded_msgs)
                _has_file = False
                _ui.set_header(model, sess_name)
                _ui.clear_chat()
                print_info(f"resumed: {sess_name}  ({len(loaded_msgs)} turns)")
            continue

        elif user_input == "/model":
            chosen = pick_model(current=model, stdscr=_ui.stdscr)
            _ui.redraw()
            if chosen != model or _auto_mode:
                model      = chosen
                _auto_mode = False
                _platy_model = model
                _ui.set_header(model, sess_name)
                print_info(f"model pinned: {model}  (auto selection OFF)")
            else:
                print_info(f"keeping current model: {model}")
            continue

        elif user_input.startswith("/load "):
            name = user_input[6:].strip()
            n, loaded = load_session_messages(name)
            if n:
                sess_name      = n
                _platy_session = sess_name
                sess_path = SESS_DIR / f"{n}.jsonl"
                messages  = ([{"role": "system", "content": SYSTEM_PROMPT}]
                             + loaded)
                _has_file = False
                _ui.set_header(model, sess_name)
                _ui.clear_chat()
                print_info(f"resumed: {sess_name}  ({len(loaded)} turns)")
            else:
                print_err(f"session not found: {name}")
            continue

        elif user_input.startswith("/web "):
            query = user_input[5:].strip()
            if not query:
                print_err("usage: /web <query>"); continue
            _ui.spin_update("○  searching…")
            results, sources = web_search(query)
            _ui.spin_stop()
            if not results:
                print_err("no results found"); continue
            print_ok(f"web results for: {query}")
            user_input = query
            search_ctx = (f"Web search results for '{query}':\n\n{results}\n\n"
                          f"Using ONLY these results, answer: {query}\n"
                          f"IMPORTANT: Each result above is prefixed [N]. "
                          f"Cite each source by its number [N] inline as you mention it. "
                          f"Do not invent sources not listed above.")
            messages.append({"role": "user", "content": search_ctx})
            save_turn(sess_path, "user", search_ctx)
            print_user(user_input)
            # web results → fast model is fine
            active = _light_model() if _auto_mode else model
            _ui.set_header(active, sess_name)
            raw_response, last_response = ask(messages, active)
            _ui.set_header(model, sess_name)
            messages.append({"role": "assistant", "content": last_response})
            save_turn(sess_path, "assistant", last_response)
            show_sources(sources)
            rule()
            continue

        elif user_input.startswith("/read "):
            result = read_file(user_input[6:].strip())
            if result:
                fpath, content = result
                inject = f"[file loaded: {fpath}]\n\n{content}"
                messages.append({"role": "user", "content": inject})
                save_turn(sess_path, "user", inject)
                _has_file = True
                print_info("file is in context — ask me anything about it")
            continue

        elif user_input.startswith("/write "):
            if not last_response:
                print_err("no response to write yet")
            else:
                script, _, _ = extract_script(raw_response)
                content = script if script else last_response.strip()
                write_file(user_input[7:].strip(), content)
            continue

        # ── drag-and-drop ─────────────────────────────────────────────────────
        dropped_path, remainder = detect_drop(user_input)
        if dropped_path:
            context = None
            if dropped_path.is_file():
                try:
                    content = dropped_path.read_text(errors="replace")
                    print_ok(f"file    {dropped_path}  ({len(content):,} chars)")
                    context = f"[file: {dropped_path}]\n\n{content}"
                    _has_file = True
                except PermissionError:
                    print_err(f"permission denied: {dropped_path}"); continue
            elif dropped_path.is_dir():
                summary = dir_summary(dropped_path)
                print_ok(f"folder  {dropped_path}")
                context = f"[folder: {dropped_path}]\n\n{summary}"
            if context:
                messages.append({"role": "user", "content": context})
                save_turn(sess_path, "user", context)
                user_input = remainder if remainder else (
                    "I just shared this with you. Briefly describe what it is "
                    "and tell me what you can help me do with it."
                )

        # ── auto-learn corrections ────────────────────────────────────────────
        if last_response and _CORRECTION_RE.match(user_input):
            correction = _CORRECTION_RE.sub("", user_input, count=1).strip()
            if correction:
                _learn_fact(correction, source="correction")
                print_info(f"  ✎ learned: {correction}")

        # ── auto web / Apple docs search ──────────────────────────────────────
        pending_sources = []
        _writing     = _is_writing_task(user_input)
        _pasted_text = _is_pasted_prose(user_input) and not _writing
        # If the user typed text before or after the paste, they already gave
        # their instruction — don't ask again, just proceed.
        if _pasted_text and _ui:
            pr = getattr(_ui, '_last_paste_range', None)
            if pr is not None:
                ps, pe = pr
                if user_input[:ps].strip() or user_input[pe:].strip():
                    _pasted_text = False
        if not _writing and not _pasted_text:
            if _DOCS_RE and _DOCS_RE.search(user_input) and DOCS_SITES:
                docs_label = DOCS_NAME or "product"
                _ui.spin_update(f"○  searching {docs_label} docs…")
                results, pending_sources = _product_docs_search(user_input)
                _ui.spin_stop()
                if results:
                    search_ctx = (f"{docs_label} documentation for '{user_input}':\n\n{results}\n\n"
                                  f"Using ONLY these results, answer: {user_input}\n"
                                  f"Answer naturally — do not cite source numbers inline. Sources are stored separately.")
                    messages.append({"role": "user", "content": search_ctx})
                    save_turn(sess_path, "user", search_ctx)
                    print_ok(f"{docs_label} docs loaded")
            elif _APPLE_RE.search(user_input) and not needs_search(user_input):
                _ui.spin_update("○  searching Apple docs…")
                results, pending_sources = _apple_docs_search(user_input)
                _ui.spin_stop()
                if results:
                    search_ctx = (f"Apple Developer documentation for '{user_input}':\n\n{results}\n\n"
                                  f"Using ONLY these results, answer: {user_input}\n"
                                  f"Answer naturally — do not cite source numbers inline. Sources are stored separately.")
                    messages.append({"role": "user", "content": search_ctx})
                    save_turn(sess_path, "user", search_ctx)
                    print_ok("Apple docs loaded")
            elif needs_search(user_input) or needs_entity_search(user_input):
                _ui.spin_update("○  searching…")
                results, pending_sources = web_search(user_input)
                _ui.spin_stop()
                if results:
                    search_ctx = (f"Web search results for '{user_input}':\n\n{results}\n\n"
                                  f"Using ONLY these results, answer: {user_input}\n"
                                  f"IMPORTANT: Each result above is prefixed [N]. "
                                  f"Cite each source by its number [N] inline as you mention it. "
                                  f"Do not invent sources not listed above.")
                    messages.append({"role": "user", "content": search_ctx})
                    save_turn(sess_path, "user", search_ctx)
                    print_ok("web search complete")

        # ── pick model for this turn ──────────────────────────────────────────
        if _deep_think:
            active = model   # deep think always needs the full/capable model
        elif _auto_mode:
            tier   = _classify(user_input, has_file=_has_file)
            active = _light_model() if tier == "fast" else model
        else:
            active = model
            # Proactive upgrade: user pinned a small model but query is complex
            if _is_small_model(active) and _classify(user_input, has_file=_has_file) == "full":
                better = _next_capable_model(active)
                if better:
                    print_info(f"  query looks complex for {active} — upgrading to {better} for this turn")
                    active = better
                elif ANTHROPIC_KEY:
                    claude = _claude_upgrade_model()
                    if claude:
                        print_info(f"  {active} may struggle with this — no stronger local model available")
                        ans = _ui.choose((f"Yes, use {claude} (costs money)", f"No, keep {active}"), default=1) if _ui \
                              else "No"
                        if ans.startswith("Yes"):
                            active = claude

        # ── send to AI ────────────────────────────────────────────────────────
        # Fuzzy-fix mistyped commands before they reach the model
        user_input = _fix_command(user_input)
        # Check for inline reminder request
        if _schedule_reminder(user_input):
            unit_hint = re.search(r'(\d+\s*(?:min|hour|sec)\w*)', user_input, re.I)
            print_ok(f"reminder set for {unit_hint.group(1) if unit_hint else 'the specified time'}")
        _last_query = user_input
        # Prepend deep-think trigger when mode is on
        ai_content = ("[DEEP THINK] " + user_input) if _deep_think else user_input
        # For writing/editing tasks: reinforce genuine rewriting, offer options
        if _writing:
            ai_content += (
                "\n\n[WRITING TASK RULES — follow exactly:\n"
                "1. Genuinely rewrite — produce a real paraphrase, not just a minor tweak or "
                "single-word change. Rework the sentence structure and word choice.\n"
                "2. Make it professional and concise.\n"
                "3. If you can think of 2 or 3 meaningfully different ways to express it, "
                "present them as numbered options: 1. ... 2. ... 3. ...\n"
                "4. Output ONLY the rewrite(s). No 'Here is the rewrite:', no explanation, "
                "no commentary before or after.]"
            )
        # For pasted prose with no instruction: ask what to do — don't analyse unprompted
        if _pasted_text:
            ai_content += (
                "\n\n[PASTED TEXT: The user has pasted text for you to work on. "
                "Do NOT summarise, analyse, or comment on it. "
                "Ask one short question: what would they like you to do with it?]"
            )
        print_user(user_input)
        # Auto-summarize if conversation is getting long
        messages = _maybe_summarize(messages)
        messages.append({"role": "user", "content": ai_content})
        save_turn(sess_path, "user", user_input)

        # Show active model in header during generation
        if active != model:
            _ui.set_header(active, sess_name)

        _no_search = not bool(pending_sources)
        raw_response, last_response = ask(messages, active,
                                          strip_phantom_cites=_no_search)

        # ── auto-upgrade if small model signalled it can't handle the query ──
        um = _UPGRADE_RE.search(raw_response)
        if um and _is_small_model(active):
            reason = um.group(1).strip()
            better = _next_capable_model(active)
            if better:
                # Local upgrade available — switch silently
                print_info(f"  {active}: {reason}")
                print_info(f"  switching to {better}…")
                _ui.set_header(better, sess_name)
                raw_response, last_response = ask(
                    messages + [{"role": "user", "content": ai_content}], better,
                    strip_phantom_cites=_no_search)
                _ui.set_header(model, sess_name)
            elif ANTHROPIC_KEY:
                # No local upgrade — offer Claude with explicit approval
                claude = _claude_upgrade_model()
                if claude:
                    print_info(f"  {active}: {reason}")
                    print_info(f"  no stronger local model found — Claude ({claude}) could handle this")
                    print_info(f"  Claude API charges per message — your call:")
                    ans = _ui.choose((f"Yes, use {claude}", "No, skip"), default=1) if _ui else "No"
                    if ans.startswith("Yes"):
                        _ui.set_header(claude, sess_name)
                        raw_response, last_response = ask(
                            messages + [{"role": "user", "content": ai_content}], claude,
                            strip_phantom_cites=_no_search)
                        _ui.set_header(model, sess_name)
                    else:
                        print_info("  keeping local model — response may be limited")
            else:
                print_info(f"  {active}: {reason} — no stronger model available locally")

        # ── handle agent blocks (parallel delegates, shell, specialized agents) ──
        delegate_tasks = _DELEGATE_RE.findall(raw_response)
        shell_cmds     = _SHELL_RE.findall(raw_response)
        agent_blocks   = _AGENT_RE.findall(raw_response)   # list of (role, task)

        result_parts = []

        if delegate_tasks:
            tasks_clean = [t.strip() for t in delegate_tasks]
            if len(tasks_clean) > 1:
                print_info(f"  running {len(tasks_clean)} parallel delegates…")
            else:
                print_info(f"  delegating: {tasks_clean[0][:70]}…")
            for t, r in _run_parallel_delegates(tasks_clean):
                result_parts.append(f"[DELEGATE RESULT]: {r}")

        for cmd in shell_cmds:
            result_parts.append(f"[SHELL RESULT]: {_run_shell_agent(cmd.strip())}")

        for role, task in agent_blocks:
            role = role.strip(); task = task.strip()
            print_info(f"  agent [{role}]: {task[:60]}…")
            result_parts.append(f"[AGENT RESULT: {role}]: {_run_iterative_agent(role, task, active)}")

        if result_parts:
            messages.append({"role": "assistant", "content": last_response})
            inject = "\n\n".join(result_parts) + "\n\nNow give your final answer using these results."
            messages.append({"role": "user", "content": inject})
            raw_response, last_response = ask(messages, active)
            messages.pop(); messages.pop()

        # Restore header, save final response
        _ui.set_header(model, sess_name)

        # ── stale-knowledge retry ─────────────────────────────────────────────
        # If AI admitted it lacks current info AND no web search was done yet, retry with search.
        # Never retry for writing/editing tasks — stale training data is irrelevant there.
        if not _writing and _STALE_RE.search(last_response) and not pending_sources:
            _ui.spin_update("○  AI lacks current info — searching the web…")
            results, pending_sources = web_search(user_input)
            _ui.spin_stop()
            if results:
                # Pop the stale assistant message, inject search context, re-ask
                messages.pop() if messages and messages[-1]["role"] == "assistant" else None
                search_ctx = (f"Web search results for '{user_input}':\n\n{results}\n\n"
                              f"Using ONLY these results, answer: {user_input}\n"
                              f"IMPORTANT: Each result is prefixed [N]. "
                              f"Answer naturally — do not cite source numbers inline. Sources are stored separately.")
                messages.append({"role": "user", "content": search_ctx})
                raw_response, last_response = ask(messages, active)
                messages.pop()   # remove injected search context from history
                print_ok("auto-searched — using live results")

        messages.append({"role": "assistant", "content": last_response})
        save_turn(sess_path, "assistant", last_response)
        show_sources(pending_sources)
        if last_response and _ui:
            _ui.add("")
            src_hint = "  /sources · view sources  ·  " if _last_sources else ""
            _ui.add(f"  {src_hint}ctrl+b · copy response", TUI.CP_INFO, dim=True)
            _ui.add("")

        # ── The Platypus Fallacy check (instant regex) ───────────────────────────
        false_claims = _check_hallucinations(last_response)
        for claim in false_claims:
            print_err(f"  Platypus Fallacy detected — {claim}")

        # Generate session label after first real exchange (background thread)
        user_turns = sum(1 for m in messages if m["role"] == "user"
                         and not m["content"].startswith("["))
        if user_turns == 1:
            threading.Thread(
                target=lambda: _save_session_meta(
                    sess_path, _generate_session_label(messages)),
                daemon=True
            ).start()

        # ── validate & auto-fix any script ────────────────────────────────────
        script, stype, fname = extract_script(raw_response)
        if script:
            last_errors = []
            for attempt in range(MAX_FIX_ATTEMPTS):
                last_errors = validate_script(script, stype)
                if not last_errors:
                    break
                print_err(f"{len(last_errors)} validation issue(s) — asking AI to fix "
                          f"(attempt {attempt + 1}/{MAX_FIX_ATTEMPTS})")
                for e in last_errors:
                    for ln in e.splitlines():
                        print_info(f"    {ln}")

                fix_prompt = (
                    "The script has the following errors. "
                    "Fix every issue and rewrite the COMPLETE corrected script "
                    "using the mandatory SCRIPT_START / SCRIPT_END markers. "
                    "Put ONLY code inside the markers — no prose, no explanations, "
                    "no numbered lists, no 'To run:' lines:\n\n"
                    + "\n\n".join(last_errors)
                )
                messages.append({"role": "user", "content": fix_prompt})
                save_turn(sess_path, "user", fix_prompt)
                raw_response, last_response = ask(messages, active)
                messages.append({"role": "assistant", "content": last_response})
                save_turn(sess_path, "assistant", last_response)
                script, stype, fname = extract_script(raw_response)
                if not script:
                    break
            else:
                if last_errors:
                    print_err(f"script still has issues after {MAX_FIX_ATTEMPTS} attempts")
                    print_info("use /write <path> to save it manually if you still want it")

            if script:
                if not last_errors:
                    print_ok("script validated clean")
                offer_save(script, fname)

        rule()


# ── One-shot ask (no curses) ──────────────────────────────────────────────────

def _oneshot(query):
    """Single-turn query with the same search/entity detection as the TUI."""
    msgs = [{"role": "system", "content": SYSTEM_PROMPT}]
    user_content = query

    # Writing/editing tasks never need a web search
    had_search = False
    if not _is_writing_task(query) and (needs_search(query) or needs_entity_search(query)):
        print("  ○  searching…", end="\r", flush=True)
        results, sources = web_search(query)
        print("                ", end="\r", flush=True)
        if results:
            had_search = True
            user_content = (
                f"Web search results for '{query}':\n\n{results}\n\n"
                f"Using ONLY these results, answer: {query}\n"
                f"Answer naturally — do not cite source numbers inline. Sources are stored separately."
            )

    if _is_writing_task(query):
        user_content += (
            "\n\n[WRITING TASK RULES — follow exactly:\n"
            "1. Genuinely rewrite — a real paraphrase, not just a minor tweak or single-word change.\n"
            "2. Make it professional and concise.\n"
            "3. If 2-3 meaningfully different versions are possible, present them as numbered options.\n"
            "4. Output ONLY the rewrite(s). No preamble, no explanation, no commentary.]"
        )

    msgs.append({"role": "user", "content": user_content})
    _, _ = ask(msgs, DEFAULT_MODEL, strip_phantom_cites=not had_search)
    print()


# ── HTTP serve mode ───────────────────────────────────────────────────────────

def _serve(port=8765):
    """
    Lightweight HTTP API server for headless / scripted access to platy.
    Runs the same search + AI pipeline as the TUI.

    POST /ask   body: plain-text query  OR  JSON {"q": "..."}
    GET  /ask?q=your+query
    GET  /health  →  200 OK

    Bind is 0.0.0.0 — intended for trusted LAN use only.
    """
    from http.server import BaseHTTPRequestHandler, HTTPServer
    from urllib.parse import urlparse, parse_qs

    def _run_query(query):
        """Run full search + AI pipeline. Returns (response_text, sources)."""
        msgs = [{"role": "system", "content": SYSTEM_PROMPT}]
        user_content = query
        had_search   = False
        sources      = []

        if not _is_writing_task(query) and (needs_search(query) or needs_entity_search(query)):
            results, sources = web_search(query)
            if results:
                had_search   = True
                user_content = (
                    f"Web search results for '{query}':\n\n{results}\n\n"
                    f"Using ONLY these results, answer: {query}\n"
                    f"IMPORTANT: Each result above is prefixed [N]. "
                    f"Answer naturally — do not cite source numbers inline. Sources are stored separately."
                )

        if _is_writing_task(query):
            user_content += ("\n\n[IMPORTANT: Return ONLY the rewritten/corrected text. "
                             "No preamble, no explanation, no commentary. Just the text itself.]")

        msgs.append({"role": "user", "content": user_content})
        _, cleaned = ask(msgs, DEFAULT_MODEL, silent=True,
                         strip_phantom_cites=not had_search)
        return cleaned, sources

    def _format_response(text, sources):
        out = text
        if sources:
            out += "\n\nsources:\n"
            for i, (title, url) in enumerate(sources, 1):
                out += f"[{i}] {title}\n    {url}\n"
        return out + "\n"

    class _Handler(BaseHTTPRequestHandler):
        def log_message(self, fmt, *args):
            ts = __import__("datetime").datetime.now().strftime("%H:%M:%S")
            addr = self.address_string()
            print(f"  {ts}  {addr}  {fmt % args}")

        def _send(self, text, status=200):
            encoded = text.encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(encoded)))
            self.end_headers()
            self.wfile.write(encoded)

        def do_GET(self):
            parsed = urlparse(self.path)
            if parsed.path in ("/", "/health"):
                self._send("platy OK\n")
                return
            if parsed.path == "/ask":
                params = parse_qs(parsed.query)
                query  = ((params.get("q") or params.get("query") or [""])[0]).strip()
                if not query:
                    self._send("missing query — use ?q=your+question\n", 400)
                    return
                response, sources = _run_query(query)
                self._send(_format_response(response, sources))
            else:
                self._send("not found\n", 404)

        def do_POST(self):
            if self.path not in ("/", "/ask"):
                self._send("not found\n", 404)
                return
            length = int(self.headers.get("Content-Length", 0))
            body   = self.rfile.read(length).decode("utf-8").strip()
            try:
                data  = json.loads(body)
                query = (data.get("q") or data.get("query") or "").strip()
            except (json.JSONDecodeError, AttributeError):
                query = body
            if not query:
                self._send("missing query\n", 400)
                return
            response, sources = _run_query(query)
            self._send(_format_response(response, sources))

    try:
        server = HTTPServer(("", port), _Handler)
    except OSError as e:
        print(f"  ✗  cannot bind to port {port}: {e}", file=sys.stderr)
        sys.exit(1)

    print(f"  ●  platy serving on http://0.0.0.0:{port}")
    print(f"     POST /ask   body: plain-text query  or  {{\"q\": \"...\"}}")
    print(f"     GET  /ask?q=your+query")
    print(f"     ⚠   LAN-only — no authentication")
    print(f"     Ctrl+C to stop")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n  ○  stopped")
        server.server_close()


# ── Entry point ───────────────────────────────────────────────────────────────

def main():
    args = sys.argv[1:]

    if args and args[0] == "--serve":
        port = 8765
        if len(args) > 1:
            try:
                port = int(args[1])
            except ValueError:
                print(f"  ✗  invalid port: {args[1]}", file=sys.stderr)
                sys.exit(1)
        _serve(port)
        return

    if args:
        _oneshot(" ".join(args))
        return

    try:
        curses.wrapper(_tui_main)
    except KeyboardInterrupt:
        pass
    finally:
        # Disable bracketed paste mode so the terminal is clean after exit
        sys.stdout.write("\x1b[?2004l")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
