    r'|who\s+(?:is|was|are|were)|who\s+(?:created|made|invented|founded|wrote|directed)))'
    r'.{0,80}[A-Z][a-zA-Z]{1,}'
    r'|'
    # C: how old/much/many/long/big/heavy/fast/does/did + Proper Noun
    r'(?i:how\s+(?:old|much|many|long|big|large|heavy|tall|wide|fast|far|does|do|did|is|are|was|were)\s+.{0,50})[A-Z][a-zA-Z]{1,}'
    r'|'
    # D: when/where did/was/is/can + Proper Noun
    r'(?i:(?:when|where)\s+(?:did|was|were|is|are|can|could|would|has|have)\s+.{0,50})[A-Z][a-zA-Z]{1,}'
    r'|'
    # E: attribute queries — specs/ingredients/caliber/price/weight of/for Proper Noun
    r'(?i:(?:specs?|specifications?|ingredients?|caliber|gauge|price|cost|weight|range|capacity)\s+(?:of|for|in|on)\s+.{0,30})[A-Z][a-zA-Z]{1,}'
