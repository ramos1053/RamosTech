def needs_entity_search(text):
    """True for factual 'who/what is X' questions about named entities."""
    if _SYS_CTX_RE.search(text):
        return False
    if _APPLE_RE.search(text) or (_DOCS_RE and _DOCS_RE.search(text)):
        return False   # already routed to specialist docs
    if _PLATY_RE.search(text):
        return False   # answered from system prompt — don't override with web results
    return bool(_ENTITY_RE.search(text))

