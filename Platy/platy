    r'|'
    # G: what year/date/version/caliber/model/specs + Proper Noun
    r'(?i:what\s+(?:year|date|version|model|caliber|gauge|size|weight|specs?)\s+.{0,50})[A-Z][a-zA-Z]{1,}'
