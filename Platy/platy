        elif user_input == "/export":
            ts   = datetime.now().strftime("%Y-%m-%d-%H-%M-%S")
            dest = Path.home() / "Desktop" / f"platy-export-{ts}.txt"
            try:
                lines = []
                for m in messages:
                    if m["role"] == "system":
