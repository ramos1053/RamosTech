    _ui.pin("auto model selection is ON  ·  /model to pin a model  ·  /auto to re-enable", TUI.CP_INFO)
    _ui.redraw()

    messages      = [{"role": "system", "content": SYSTEM_PROMPT}]
    last_response = ""
    raw_response  = ""

