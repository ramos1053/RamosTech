    return bool(_SEARCH_RE.search(text))

# ── The Platypus Fallacy detector ────────────────────────────────────────────
# Catches confident-sounding statements whose internal logic collapses on inspection.
# Named after observing the AI claim a platypus "lacks fur like reptiles" —
# a comparison that is wrong on both ends simultaneously.

_FALLACY_CHECKS = [
    # Broad logical contradictions — things no model should ever get wrong.
    # (pattern, plain-English correction shown to the user)
    (re.compile(r'reptile[s]?\b.{0,60}\bfur\b',          re.I), "reptiles do not have fur"),
    (re.compile(r'fur\b.{0,60}\blike\b.{0,30}\breptile', re.I), "reptiles do not have fur"),
    (re.compile(r'bird[s]?\b.{0,60}\bteeth\b',           re.I), "modern birds do not have teeth"),
    (re.compile(r'fish\b.{0,60}\blungs?\b(?!.*lungfish)', re.I), "most fish do not have lungs"),
    (re.compile(r'insect[s]?\b.{0,60}\bbone[s]?\b',      re.I), "insects have no bones"),
    (re.compile(r'plant[s]?\b.{0,60}\bbrain[s]?\b',      re.I), "plants do not have brains"),
    (re.compile(r'mammal[s]?\b.{0,60}\bcold.blooded',    re.I), "mammals are warm-blooded"),
    (re.compile(r'reptile[s]?\b.{0,60}\bwarm.blooded',   re.I), "reptiles are cold-blooded"),
    # Environmental exposure causing impossible physical transformation in humans
    (re.compile(
        r'(exposure|contamination|chemical[s]?|pollut\w+|radiation)\b.{0,100}'
        r'\b(grow(ing)?|develop(ing)?|caus\w+|result\w+|lead\w*)\b.{0,80}'
        r'\b(human[s]?|people|person|resident[s]?|victim[s]?)\b.{0,80}'
        r'\b(physical\s+change[s]?|transform\w*|mutate[sd]?|evolve[sd]?|'
        r'animal\s+feature[s]?|aquatic\s+feature[s]?)',
        re.I | re.DOTALL),
     "environmental exposure cannot cause impossible physical transformations — "
     "this may be fiction being described as real"),
]

def _check_hallucinations(text):
    """Detect The Platypus Fallacy — confident claims whose logic collapses on inspection."""
    warnings = []
    for pattern, correction in _FALLACY_CHECKS:
        if pattern.search(text):
            warnings.append(correction)
    return warnings


# ── Numbered-option extraction ─────────────────────────────────────────────────

_OPT_RE = re.compile(r'^\s{0,4}(\d+)[.)]\s+(.+)', re.MULTILINE)

def extract_options(text):
    """Return list of option strings if the response contains a numbered list (2-8 items)."""
    matches = _OPT_RE.findall(text)
    if len(matches) < 2 or len(matches) > 8:
        return []
    # Ensure numbering is sequential starting at 1
    nums = [int(n) for n, _ in matches]
    if nums != list(range(1, len(nums) + 1)):
        return []
    return [t.strip() for _, t in matches]

# ── Command fuzzy-correction ───────────────────────────────────────────────────

_KNOWN_CMDS = [
    "/web", "/apple", "/docs", "/model", "/auto", "/read", "/write", "/clear", "/exit",
    "/help", "/sessions", "/load", "/serper", "/think", "/sources",
    "/pin", "/learn", "/forget", "/memory",
]

def _fix_command(text):
    """Auto-correct a mistyped slash command. Returns corrected text."""
    if not text.startswith("/"):
        return text
    parts = text.split(None, 1)
    cmd   = parts[0].lower()
    if cmd in _KNOWN_CMDS:
        return text
    close = difflib.get_close_matches(cmd, _KNOWN_CMDS, n=1, cutoff=0.55)
    if close:
        return close[0] + (" " + parts[1] if len(parts) > 1 else "")
    return text

# ── Ollama / model helpers ─────────────────────────────────────────────────────

_MODELS_CACHE_TTL = 30   # seconds — avoids redundant HTTP round-trips to the
                         # local ollama daemon when several call sites need
                         # the model list within the same turn
_models_cache    = None
_models_cache_ts = 0.0

def get_models(force=False):
    """Local ollama models first, Claude API models listed last as opt-in.
    Cached for _MODELS_CACHE_TTL seconds; pass force=True to bypass (e.g.
    right after the user may have pulled/removed a model out-of-band)."""
    global _models_cache, _models_cache_ts
    if not force and _models_cache is not None and time.time() - _models_cache_ts < _MODELS_CACHE_TTL:
        return _models_cache
    out = []
    try:
        with urlopen(Request(f"{API_BASE}/api/tags"), timeout=5) as resp:
            data = json.loads(resp.read())
            for m in data.get("models", []):
                raw = m.get("size", 0)
                gb  = raw / 1_073_741_824
                sz  = f"{gb:.1f} GB" if gb >= 1 else f"{raw/1_048_576:.0f} MB"
                out.append((m["name"], sz))
    except Exception:
        pass
    if not out:
        out.append((DEFAULT_MODEL, ""))
    # Claude models appended last — available but never auto-selected
    if ANTHROPIC_KEY:
        out.extend(CLAUDE_MODELS)
    _models_cache    = out
    _models_cache_ts = time.time()
    return out

# ── TUI ────────────────────────────────────────────────────────────────────────

_ui = None   # set inside _tui_main(); None in one-shot mode


class TUI:
    CP_NORMAL = 1   # white
    CP_STATUS = 2   # white on blue  (header bar)
    CP_USER   = 3   # yellow bold    (user turn label)
    CP_AI     = 4   # white          (AI response)
    CP_OK     = 5   # green          (success / confident fact)
    CP_ERR    = 6   # red            (errors / Platypus Fallacy)
    CP_INFO   = 7   # dim white      (info / separators)
    CP_CYAN   = 8   # cyan           (accents)
    CP_WARN   = 9   # yellow         (uncertain / unverified)

    _RENDER_INTERVAL = 0.04   # ~25/sec cap on full redraws during rapid-fire add() bursts (streaming)

    def __init__(self, stdscr):
        self.stdscr = stdscr
        self._lock  = threading.Lock()
        self._last_render_ts = 0.0

        self._lines        = []   # list of (cp, text, bold)
        self._pinned_lines = []   # always-visible lines at top (mascot + help)
        self._scroll       = 0   # lines from bottom (0 = at bottom)

        self._model   = DEFAULT_MODEL
        self._session = ""
        self._spin_text   = ""
        self._spin_active = False

        self._history        = []   # entered commands
        self._last_paste_range = None
        self._h = self._w = 0

        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(self.CP_NORMAL, curses.COLOR_WHITE,  -1)
        curses.init_pair(self.CP_STATUS, curses.COLOR_WHITE,  curses.COLOR_BLUE)
        curses.init_pair(self.CP_USER,   curses.COLOR_YELLOW, -1)
        curses.init_pair(self.CP_AI,     curses.COLOR_WHITE,  -1)
        curses.init_pair(self.CP_OK,     curses.COLOR_GREEN,  -1)
        curses.init_pair(self.CP_ERR,    curses.COLOR_RED,    -1)
        curses.init_pair(self.CP_INFO,   curses.COLOR_WHITE,  -1)
        curses.init_pair(self.CP_CYAN,   curses.COLOR_CYAN,   -1)
        curses.init_pair(self.CP_WARN,   curses.COLOR_YELLOW, -1)

        stdscr.keypad(True)
        curses.curs_set(1)
        # Bracketed paste mode: terminal wraps pasted text with ESC[200~ / ESC[201~
        # so we can accumulate the whole block before acting on it.
        # Mouse capture is intentionally NOT set — any mousemask() call puts the
        # terminal into mouse-tracking mode and prevents click-and-drag text selection.
        # Trackpad scroll reaches us as KEY_UP/KEY_DOWN in alternate-screen mode instead.
        try:
            curses.define_key("\x1b[200~", 510)  # paste-start marker
            curses.define_key("\x1b[201~", 511)  # paste-end   marker
            curses.define_key("\x1b[1;2A", 512)  # Shift+Up   → scroll up
            curses.define_key("\x1b[1;2B", 513)  # Shift+Down → scroll down
        except Exception:
            pass
        # Enable bracketed paste in the terminal emulator
        sys.stdout.write("\x1b[?2004h")
        sys.stdout.flush()
        self._resize()

    # ── sizing ─────────────────────────────────────────────────────────────────

    def _resize(self):
        self._h, self._w = self.stdscr.getmaxyx()

    @property
    def _chat_rows(self):
        """Rows available for chat (between status bar and input row)."""
        return max(1, self._h - 3)  # status(1) + separator(1) + input(1)

    @property
    def _scroll_rows(self):
        """Rows available for scrollable content (chat_rows minus pinned header and pin-separator)."""
        return max(1, self._chat_rows - len(self._pinned_lines) - 1)

    # ── public API ─────────────────────────────────────────────────────────────

    def set_header(self, model, session):
        self._model   = model
        self._session = session

    def add(self, text, cp=None, bold=False, dim=False):
        """Append a completed line to the chat area. Thread-safe.
        Full redraws are throttled to _RENDER_INTERVAL so a fast burst of
        appends (e.g. a streaming AI response) doesn't redraw the whole
        pane once per line — callers that need an immediate flush (end of
        a stream, resize, etc.) should follow up with redraw()."""
        if cp is None:
            cp = self.CP_AI
        with self._lock:
            self._hard_wrap_append(text, cp, bold, dim=dim)
            if self._scroll == 0:
                now = time.time()
                if now - self._last_render_ts >= self._RENDER_INTERVAL:
                    self._render()
                    self._last_render_ts = now

    def clear_chat(self):
        """Erase all chat lines and redraw."""
        with self._lock:
            self._lines.clear()
            self._scroll = 0
            self._render()

    def pin(self, text, cp=None, bold=False):
        """Append a line to the always-visible pinned header (mascot/help). Not scrollable."""
        if cp is None:
            cp = self.CP_CYAN
        max_w = max(1, self._w - 3)
        if not text:
            self._pinned_lines.append((cp, "", bold))
            return
        while len(text) > max_w:
            self._pinned_lines.append((cp, text[:max_w], bold))
            text = text[max_w:]
        self._pinned_lines.append((cp, text, bold))

    def spin_update(self, text):
        """Update spinner text in status bar. Safe to call from any thread."""
        self._spin_text   = text
        self._spin_active = True
        with self._lock:
            self._render_status()
            self.stdscr.noutrefresh()
            curses.doupdate()

    def spin_stop(self):
        """Clear spinner, restore normal status bar."""
        self._spin_active = False
        self._spin_text   = ""
        with self._lock:
            self._render_status()
            self.stdscr.noutrefresh()
            curses.doupdate()

    def redraw(self):
        """Full redraw. Thread-safe."""
        with self._lock:
            self._render()
            self._last_render_ts = time.time()

    # ── internal rendering ─────────────────────────────────────────────────────

    def _hard_wrap_append(self, text, cp, bold, dim=False):
        """Append text with markdown parsing, word-wrapping at terminal width. Must hold _lock."""
        # Strip newlines — curses addstr will bleed onto adjacent rows otherwise
        text = text.replace("\r", "").replace("\n", " ").strip()
        max_w = max(1, self._w - 3)
        if not text:
            self._lines.append((cp, "", bold, None, dim))
            return
        plain, cp, bold, segs = _parse_md_segs(text, cp)
        # If segs fit on one line, store rich
        if segs and len(plain) <= max_w:
            self._lines.append((cp, plain, bold, segs, dim))
            return
        # Short enough to fit — store as-is
        if len(plain) <= max_w:
            self._lines.append((cp, plain, bold, None, dim))
            return
        # Word-boundary wrapping
        words = plain.split(' ')
        current = ''
        for word in words:
            if not word:
                continue
            if current and len(current) + 1 + len(word) > max_w:
                self._lines.append((cp, current, bold, None, dim))
                current = word
            elif current:
                current = current + ' ' + word
            else:
                # Single word longer than max_w — hard-break it
                while len(word) > max_w:
                    self._lines.append((cp, word[:max_w], bold, None, dim))
                    word = word[max_w:]
                current = word
        if current:
            self._lines.append((cp, current, bold, None, dim))

    def _render_status(self):
        """Draw status bar at row 0. Must hold _lock."""
        w = self._w
        right = (f"  {self._spin_text}  " if self._spin_active
                 else (f"  {self._session}  " if self._session else "    "))
        left  = f"  PLATY  ·  {self._model}  "
        fill  = "·" * max(0, w - len(left) - len(right))
        bar   = (left + fill + right)[:w]
        try:
            self.stdscr.addstr(0, 0, bar,
                               curses.color_pair(self.CP_STATUS) | curses.A_BOLD)
        except curses.error:
            pass

    def _render(self):
        """Full screen redraw. Must hold _lock."""
        try:
            h, w = self._h, self._w
            chat_rows   = self._chat_rows
            num_pinned  = len(self._pinned_lines)
            scroll_rows = self._scroll_rows

            self._render_status()

            # ── pinned header (mascot + help) — never scrollable ──────────────
            for i, (cp, text, bold) in enumerate(self._pinned_lines):
                row = 1 + i
                if row >= h - 2:
                    break
                try:
                    self.stdscr.move(row, 0)
                    self.stdscr.clrtoeol()
                    if text:
                        attr = curses.color_pair(cp)
                        if bold:
                            attr |= curses.A_BOLD
                        self.stdscr.addstr(row, 0, ("  " + text)[:w - 1], attr)
                except curses.error:
                    pass

            # ── fixed separator between header and chat ────────────────────────
            pin_sep_row = 1 + num_pinned
            if pin_sep_row < h - 2:
                try:
                    self.stdscr.move(pin_sep_row, 0)
                    self.stdscr.clrtoeol()
                    self.stdscr.addstr(pin_sep_row, 0, "═" * (w - 1),
                                       curses.color_pair(self.CP_CYAN) | curses.A_DIM)
                except curses.error:
                    pass

            # ── scrollable chat area (starts one row below the pin separator) ──
            total = len(self._lines)
            max_scroll = max(0, total - scroll_rows)
            self._scroll = min(self._scroll, max_scroll)

            if total <= scroll_rows and self._scroll == 0:
                start_idx = 0
            else:
                end_idx   = total - self._scroll
                start_idx = max(0, end_idx - scroll_rows)

            for i in range(scroll_rows):
                row = 2 + num_pinned + i   # +2: status(1) + pin-sep(1)
                if row >= h - 2:
                    break
                idx = start_idx + i
                try:
                    self.stdscr.move(row, 0)
                    self.stdscr.clrtoeol()
                except curses.error:
                    pass
                if 0 <= idx < total:
                    entry = self._lines[idx]
                    cp, text, bold, segs = entry[:4]
                    dim = entry[4] if len(entry) > 4 else False
                    if segs:
                        # Rich inline rendering (bold/code segments)
                        x = 2
                        for seg_text, seg_cp, seg_attrs in segs:
                            avail = max(0, w - 1 - x)
                            if avail <= 0:
                                break
                            clipped = seg_text[:avail]
                            try:
                                self.stdscr.addstr(row, x, clipped,
                                    curses.color_pair(seg_cp) | seg_attrs)
                                x += len(clipped)
                            except curses.error:
                                break
                    else:
                        attr = curses.color_pair(cp)
                        if bold:
                            attr |= curses.A_BOLD
                        if dim:
                            attr |= curses.A_DIM
                        try:
                            self.stdscr.addstr(row, 0, ("  " + text)[:w - 1], attr)
                        except curses.error:
                            pass

            # ── separator row ─────────────────────────────────────────────────
            sep_row = 1 + chat_rows
            try:
                self.stdscr.addstr(sep_row, 0, "─" * (w - 1),
                                   curses.color_pair(self.CP_INFO) | curses.A_DIM)
                if self._scroll > 0:
                    ind = f" ↑ {self._scroll} lines  PgDn ↓ "
                    self.stdscr.addstr(sep_row, 2, ind,
                                       curses.color_pair(self.CP_CYAN))
                if _clip_changed:
                    hint = " 📋 clipboard changed · /paste "
                    col  = max(2, w - len(hint) - 2)
                    self.stdscr.addstr(sep_row, col, hint,
                                       curses.color_pair(self.CP_CYAN) | curses.A_DIM)
            except curses.error:
                pass

        except curses.error:
            pass
        finally:
            try:
                self.stdscr.noutrefresh()
                curses.doupdate()
            except curses.error:
                pass

    # ── input ──────────────────────────────────────────────────────────────────

    def get_input(self):
        """
        Full-featured line editor on the bottom row.
        Keys: arrows, Home/End, Ctrl+A/E/K/U/W, Backspace, Delete,
              Ctrl+B (copy last response), Ctrl+D (quit),
              PgUp/PgDn (scroll chat), Up/Dn (history when typing, scroll when empty).
        Paste: bracketed-paste mode lets you paste multi-line blocks as one query.
        Returns entered string, or None on Ctrl+D.
        """
        buf         = []
        cursor      = 0
        hist_idx    = len(self._history)
        saved_buf   = ""
        _in_paste   = False  # True while inside a bracketed-paste block
        paste_mark  = 0      # buf index where paste will be inserted
        paste_chars = []     # accumulates chars DURING paste (kept out of buf until end)
        paste_range = None   # (start, end) in buf after paste is committed; None = no paste

        prompt_str = "● ▸ "
        prompt_len = len(prompt_str)
        input_row  = self._h - 1
        max_input  = self._w - prompt_len - 2
        offset     = 0

        curses.curs_set(1)

        def render():
            nonlocal offset
            try:
                self.stdscr.move(input_row, 0)
                self.stdscr.clrtoeol()
                self.stdscr.addstr(input_row, 0, prompt_str,
                                   curses.color_pair(self.CP_OK) | curses.A_BOLD)
                if paste_range is not None:
                    ps, pe = paste_range
                    pasted  = "".join(buf[ps:pe])
                    n_words = len(pasted.split())
                    n_lines = pasted.count("\n") + 1
                    label       = f"[Pasted text · {n_words} words · {n_lines} lines]"
                    pre         = "".join(buf[:ps])
                    post        = "".join(buf[pe:])
                    display     = pre + label + post
                    label_start = len(pre)
                    label_end   = label_start + len(label)
                    # Map logical cursor → display cursor
                    if cursor <= ps:
                        disp_cur = cursor
                    elif cursor <= pe:
                        disp_cur = label_end
                    else:
                        disp_cur = cursor - (pe - ps) + len(label)
                    # Window
                    if disp_cur - offset >= max_input:
                        offset = disp_cur - max_input + 1
                    elif disp_cur - offset < 0:
                        offset = disp_cur
                    # Render char by char so label colouring works cleanly
                    x = prompt_len
                    for i, glyph in enumerate(display[offset:offset + max_input]):
                        abs_i = offset + i
                        if label_start <= abs_i < label_end:
                            attr = curses.color_pair(self.CP_USER) | curses.A_DIM
                        else:
                            attr = curses.color_pair(self.CP_NORMAL)
                        try:
                            self.stdscr.addstr(input_row, x, glyph, attr)
                        except curses.error:
                            break
                        x += 1
                    self.stdscr.move(input_row,
                                     min(prompt_len + disp_cur - offset,
                                         prompt_len + max_input - 1))
                else:
                    if cursor - offset >= max_input:
                        offset = cursor - max_input + 1
                    elif cursor - offset < 0:
                        offset = cursor
                    visible = "".join(buf[offset:offset + max_input])
                    self.stdscr.addstr(input_row, prompt_len, visible,
                                       curses.color_pair(self.CP_NORMAL))
                    self.stdscr.move(input_row, prompt_len + cursor - offset)
                self.stdscr.noutrefresh()
                curses.doupdate()
            except curses.error:
                pass

        self.stdscr.nodelay(False)
        render()

        while True:
            try:
                ch = self.stdscr.getch()
            except KeyboardInterrupt:
                raise

            if ch == curses.KEY_RESIZE:
                self._resize()
                input_row  = self._h - 1
                max_input  = self._w - prompt_len - 2
                with self._lock:
                    self._render()
                render()

            elif ch in (curses.KEY_PPAGE, 566, 512):  # PgUp / Ctrl+Up / Shift+Up
                with self._lock:
                    step = 3 if ch in (566, 512) else self._scroll_rows // 2
                    self._scroll = min(self._scroll + step,
                                       max(0, len(self._lines) - self._scroll_rows))
                    self._render()
                render()

            elif ch in (curses.KEY_NPAGE, 525, 513):  # PgDn / Ctrl+Down / Shift+Down
                with self._lock:
                    step = 3 if ch in (525, 513) else self._scroll_rows // 2
                    self._scroll = max(0, self._scroll - step)
                    self._render()
                render()

            elif ch == 510:          # bracketed-paste START
                _in_paste   = True
                paste_mark  = cursor
                paste_chars = []

            elif ch == 511:          # bracketed-paste END
                _in_paste = False
                for i, c in enumerate(paste_chars):
                    buf.insert(paste_mark + i, c)
                cursor      = paste_mark + len(paste_chars)
                paste_range = (paste_mark, cursor)
                paste_chars = []
                render()

            elif ch in (curses.KEY_ENTER, ord('\n'), ord('\r')):
                if _in_paste:
                    # Paste in progress — newline goes to paste accumulator, not buf
                    paste_chars.append('\n')
                    continue
                # Peek ahead: paste bursts arrive as a flood of chars with no gap.
                # If input is immediately available, this \n is mid-paste — treat
                # it as a literal newline in the buffer, not a submit trigger.
                # Also handles \r\n (Windows line endings) — skip bare \r.
                self.stdscr.nodelay(True)
                _peek = self.stdscr.getch()
                self.stdscr.nodelay(False)
                if _peek == ord('\r'):
                    # CR from Windows paste — discard it and read one more
                    self.stdscr.nodelay(True)
                    _peek = self.stdscr.getch()
                    self.stdscr.nodelay(False)
                if _peek != -1:
                    buf.insert(cursor, '\n')
                    cursor += 1
                    curses.ungetch(_peek)   # put the peeked char back
                    render()
                    continue
                # Nothing follows immediately → real Enter key, submit the buffer
                global _clip_changed
                _clip_changed = False
                raw  = "".join(buf)
                line = raw.strip()
                line = re.sub(r'\x1b?\[20[01]~', '', line)
                # Store paste_range adjusted for any leading whitespace stripped,
                # so print_user can reconstruct pre + label + post for display.
                if paste_range is not None:
                    leading = len(raw) - len(raw.lstrip())
                    ps, pe  = paste_range
                    self._last_paste_range = (max(0, ps - leading),
                                              max(0, pe - leading))
                else:
                    self._last_paste_range = None
                paste_range = None
                if line:
                    self._history.append(line)
                try:
                    self.stdscr.move(input_row, 0)
                    self.stdscr.clrtoeol()
                    self.stdscr.noutrefresh()
                    curses.doupdate()
                except curses.error:
                    pass
                return line

            elif ch == 4:   # Ctrl+D
                return None

            elif ch == 3:   # Ctrl+C
                raise KeyboardInterrupt

            elif ch == 2:   # Ctrl+B — copy/show last AI response + sources
                if _last_ai_response:
                    clip_text = _last_ai_response
                    if _last_sources:
                        lines = ["\n\nsources:"]
                        for i, (title, url) in enumerate(_last_sources, 1):
                            lines.append(f"[{i}] {title}")
                            lines.append(f"    {url}")
                        clip_text += "\n".join(lines)
                    ok, method = _copy_to_clipboard(clip_text)
                    if ok:
                        src_note = f" + {len(_last_sources)} sources" if _last_sources else ""
                        with self._lock:
                            self._spin_text   = f"✓  response{src_note} copied to clipboard"
                            self._spin_active = True
                            self._render_status()
                            self.stdscr.noutrefresh()
                            curses.doupdate()
                        time.sleep(1.5)
                        with self._lock:
                            self._spin_active = False
                            self._spin_text   = ""
                            self._render_status()
                            self.stdscr.noutrefresh()
                            curses.doupdate()
                    elif method == "ssh":
                        # SSH session — suspend curses and print as plain text
                        # so the user can mouse-select and copy normally
                        curses.endwin()
                        print(f"\n{CYAN}{'─' * 60}{R}")
                        print(clip_text)
                        print(f"{CYAN}{'─' * 60}{R}")
                        print(f"\n{DGRAY}select the text above to copy  ·  press Enter to return{R}")
                        try:
                            sys.stdin.readline()
                        except Exception:
                            pass
                        self.stdscr = curses.initscr()
                        curses.noecho()
                        curses.cbreak()
                        self.stdscr.keypad(True)
                        with self._lock:
                            self._render()
                render()

            elif ch == curses.KEY_UP:
                if not buf:
                    # Empty input → scroll chat up (macOS Terminal sends trackpad
                    # scroll-up as KEY_UP in alternate-screen mode)
                    with self._lock:
                        self._scroll = min(self._scroll + 3,
                                           max(0, len(self._lines) - self._scroll_rows))
                        self._render()
                    render()
                elif hist_idx > 0:
                    if hist_idx == len(self._history):
                        saved_buf = "".join(buf)
                    hist_idx   -= 1
                    buf         = list(self._history[hist_idx])
                    cursor      = len(buf)
                    paste_range = None
                    render()

            elif ch == curses.KEY_DOWN:
                if not buf:
                    # Empty input → scroll chat down
                    with self._lock:
                        self._scroll = max(0, self._scroll - 3)
                        self._render()
                    render()
                elif hist_idx < len(self._history):
                    hist_idx += 1
                    if hist_idx == len(self._history):
                        buf = list(saved_buf)
                    else:
                        buf = list(self._history[hist_idx])
                    cursor      = len(buf)
                    paste_range = None
                    render()

            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                if paste_range is not None:
                    ps, pe = paste_range
                    if cursor == pe:
                        # Backspace onto label — wipe the entire paste block
                        del buf[ps:pe]
                        paste_range = None
                        cursor      = ps
                    elif cursor > pe:
                        buf.pop(cursor - 1)
                        cursor -= 1
                    elif cursor > 0:
                        buf.pop(cursor - 1)
                        cursor -= 1
                elif cursor > 0:
                    buf.pop(cursor - 1)
                    cursor -= 1
                render()

            elif ch == curses.KEY_DC:
                if paste_range is not None:
                    ps, pe = paste_range
                    if cursor == ps:
                        # Delete-forward onto label — wipe the entire paste block
                        del buf[ps:pe]
                        paste_range = None
                    elif cursor < len(buf):
                        buf.pop(cursor)
                elif cursor < len(buf):
                    buf.pop(cursor)
                render()

            elif ch == curses.KEY_LEFT:
                if paste_range is not None:
                    ps, pe = paste_range
                    if cursor == pe:
                        cursor = ps   # jump over label as one unit
                    elif cursor > pe:
                        cursor -= 1
                    elif cursor > 0:
                        cursor -= 1
                else:
                    cursor = max(0, cursor - 1)
                render()

            elif ch in (curses.KEY_RIGHT, 6):
                if paste_range is not None:
                    ps, pe = paste_range
                    if cursor == ps:
                        cursor = pe   # jump over label as one unit
                    elif cursor < len(buf):
                        cursor += 1
                else:
                    cursor = min(len(buf), cursor + 1)
                render()

            elif ch in (curses.KEY_HOME, 1):
                cursor = 0
                render()

            elif ch in (curses.KEY_END, 5):
                cursor = len(buf)
                render()

            elif ch == 11:  # Ctrl+K
                if paste_range is not None:
                    ps, pe = paste_range
                    if cursor <= pe:
                        paste_range = None
                buf[cursor:] = []
                render()

            elif ch == 21:  # Ctrl+U
                buf[:cursor] = []
                paste_range = None
                cursor = 0
                render()

            elif ch == 23:  # Ctrl+W
                while cursor > 0 and buf[cursor - 1] == ' ':
                    buf.pop(cursor - 1); cursor -= 1
                while cursor > 0 and buf[cursor - 1] != ' ':
                    buf.pop(cursor - 1); cursor -= 1
                render()

            elif 32 <= ch <= 126 or (_in_paste and ch > 126):
                if _in_paste:
                    # Paste in progress — accumulate separately so buf stays newline-free
                    paste_chars.append(chr(ch))
                    try:
                        ptail = "".join(paste_chars[-6:])
                        if ptail.endswith("[201~"):
                            mlen = 6 if ptail.endswith("\x1b[201~") else 5
                            del paste_chars[-mlen:]
                            for i, c in enumerate(paste_chars):
                                buf.insert(paste_mark + i, c)
                            cursor      = paste_mark + len(paste_chars)
                            paste_range = (paste_mark, cursor)
                            paste_chars = []
                            _in_paste   = False
                    except Exception:
                        pass
                else:
                    buf.insert(cursor, chr(ch))
                    cursor += 1
                    # Detect [200~ leaking as plain chars when define_key misses it.
                    # ESC (27) is dropped by curses; [200~ passes through as text.
                    try:
                        tail = "".join(buf[max(0, cursor - 6):cursor])
                        if tail.endswith("[200~"):
                            mlen        = 6 if "\x1b[200~" in tail else 5
                            del buf[cursor - mlen:cursor]
                            cursor     -= mlen
                            _in_paste   = True
                            paste_mark  = cursor
                            paste_chars = []
                    except Exception:
                        pass
                render()

    def prompt(self, question):
        """
        Show a question on the input row and return a short answer.
        Used for confirmations and one-liner inputs inside commands.
        """
        input_row = self._h - 1
        q_str = f"  {question} "
        try:
            self.stdscr.move(input_row, 0)
            self.stdscr.clrtoeol()
            self.stdscr.addstr(input_row, 0, q_str[:self._w - 1],
                               curses.color_pair(self.CP_CYAN) | curses.A_BOLD)
            self.stdscr.noutrefresh()
            curses.doupdate()
        except curses.error:
            pass
        curses.flushinp()
        return _inline_input(self.stdscr, input_row, len(q_str), self._w)

    def choose(self, options=("Yes", "No", "Add context"), default=1):
        """
        Render a horizontal button strip on the input row.
        ◀/▶ or left/right moves the highlight; Enter confirms.
        Returns the selected option string, or "" on Escape.
        If "Add context" is chosen, drops into a text-input and returns the typed text.
        """
        sel      = default
        row      = self._h - 1
        curses.flushinp()

        def _draw(sel):
            try:
                self.stdscr.move(row, 0)
                self.stdscr.clrtoeol()
                x = 2
                for i, opt in enumerate(options):
                    if i == sel:
                        label = f" ● {opt} "
                        attr  = curses.color_pair(self.CP_OK) | curses.A_BOLD | curses.A_REVERSE
                    else:
                        label = f"   {opt} "
                        attr  = curses.color_pair(self.CP_INFO)
                    if x + len(label) < self._w:
                        self.stdscr.addstr(row, x, label, attr)
                    x += len(label) + 1
                self.stdscr.noutrefresh()
                curses.doupdate()
            except curses.error:
                pass

        while True:
            _draw(sel)
            try:
                key = self.stdscr.getch()
            except curses.error:
                return ""

            if key in (curses.KEY_LEFT, ord('h')):
                sel = (sel - 1) % len(options)
            elif key in (curses.KEY_RIGHT, ord('l')):
                sel = (sel + 1) % len(options)
            elif key in (10, 13, curses.KEY_ENTER):       # Enter
                chosen = options[sel]
                if chosen == "Add context":
                    # switch to free-text input on the same row
                    try:
                        self.stdscr.move(row, 0)
                        self.stdscr.clrtoeol()
                        prompt = "  context: "
                        self.stdscr.addstr(row, 0, prompt,
                                           curses.color_pair(self.CP_CYAN) | curses.A_BOLD)
                        self.stdscr.noutrefresh()
                        curses.doupdate()
                    except curses.error:
                        pass
                    return _inline_input(self.stdscr, row, len("  context: "), self._w)
                return chosen
            elif key == 27:                                # Escape → default
                return options[default]

    def option_select(self, options):
        """
        Show an arrow-key navigable selector for a numbered list returned by the AI.
        Up/down (or j/k) moves selection; Enter sends it; Esc dismisses.
        Returns the chosen option text, or None if dismissed.
        """
        if not options:
            return None
        sel = 0
        row = self._h - 1
        hint = "  ↑↓ select option  ·  Enter to send  ·  Esc to type manually"
        curses.flushinp()

        def _draw():
            try:
                self.stdscr.move(row, 0)
                self.stdscr.clrtoeol()
                num   = f"[{sel + 1}/{len(options)}] "
                label = (num + options[sel])[:self._w - len(hint) - 4]
                line  = f"  {label:<{self._w - len(hint) - 4}}{hint}"
                self.stdscr.addstr(row, 0, line[:self._w - 1],
                                   curses.color_pair(self.CP_OK) | curses.A_BOLD)
                self.stdscr.noutrefresh()
                curses.doupdate()
            except curses.error:
                pass

        while True:
            _draw()
            try:
                key = self.stdscr.getch()
            except curses.error:
                return None
            if key in (curses.KEY_UP, ord('k')):
                sel = (sel - 1) % len(options)
            elif key in (curses.KEY_DOWN, ord('j')):
                sel = (sel + 1) % len(options)
            elif key in (10, 13, curses.KEY_ENTER):
                return options[sel]
            elif key == 27:
                return None


# ── Inline mini-input (used by prompt() and session_manager) ──────────────────

def _inline_input(stdscr, row, col, max_w):
    """Minimal in-place line input. Returns entered string."""
    buf       = []
    max_chars = max(1, max_w - col - 1)

    curses.curs_set(1)

    def render():
        try:
            stdscr.move(row, col)
            stdscr.clrtoeol()
            visible = "".join(buf)[-max_chars:]
            stdscr.addstr(row, col, visible)
            stdscr.move(row, col + min(len(buf), max_chars))
            stdscr.noutrefresh()
            curses.doupdate()
        except curses.error:
            pass

    render()

    while True:
        try:
            ch = stdscr.getch()
        except KeyboardInterrupt:
            return ""
        if ch in (curses.KEY_ENTER, ord('\n'), ord('\r')):
            return "".join(buf)
        elif ch in (27, 4):
            return ""
        elif ch == 3:
            return ""
        elif ch in (curses.KEY_BACKSPACE, 127, 8):
            if buf:
                buf.pop()
        elif 32 <= ch <= 126:
            buf.append(chr(ch))
        render()


def _inline_input_prefill(stdscr, row, col, max_w, prefill=""):
    """Like _inline_input but with pre-filled text the user can edit."""
    buf       = list(prefill)
    max_chars = max(1, max_w - col - 1)

    curses.curs_set(1)

    def render():
        try:
            stdscr.move(row, col)
            stdscr.clrtoeol()
            visible = "".join(buf)[-max_chars:]
            stdscr.addstr(row, col, visible)
            stdscr.move(row, col + min(len(buf), max_chars))
            stdscr.noutrefresh()
            curses.doupdate()
        except curses.error:
            pass

    render()

    while True:
        try:
            ch = stdscr.getch()
        except KeyboardInterrupt:
            return prefill
        if ch in (curses.KEY_ENTER, ord('\n'), ord('\r')):
            return "".join(buf)
        elif ch in (27, 4):
            return prefill   # Esc → cancel, restore original
        elif ch == 3:
            return prefill
        elif ch in (curses.KEY_BACKSPACE, 127, 8):
            if buf:
                buf.pop()
        elif 32 <= ch <= 126:
            buf.append(chr(ch))
        render()


# ── Memory browser (full-screen curses) ───────────────────────────────────────

def memory_browser(stdscr):
    """
    Full-screen memory editor.
    ↑↓ navigate · e edit · d delete · a add · tab toggle section · q back
    """
    CP_HDR  = 2   # white on blue
    CP_CUR  = 8   # cyan + reverse
    CP_PIN  = 5   # green  — pinned facts
    CP_LRN  = 9   # yellow — learned facts
    CP_DIM  = 7   # dim
    CP_ERR  = 6   # red

    SECTION_LABELS = {"pinned": "PINNED  (/pin)", "learned": "LEARNED  (/learn · auto)"}

    def _entries():
        """Flat ordered list of (section, key, text, source_or_None)."""
        out = []
        for k, v in _memory.items():
            out.append(("pinned", k, v, None))
        for k, v in _learned.items():
            fact = v["fact"] if isinstance(v, dict) else v
            src  = v.get("source", "?") if isinstance(v, dict) else "?"
            out.append(("learned", k, fact, src))
        return out

    cur = 0

    def draw(entries):
        nonlocal cur
        h, w = stdscr.getmaxyx()
        stdscr.erase()

        hdr = ("  MEMORY BROWSER  ·  ↑↓ navigate  ·  e edit  ·  a add  "
               "·  d delete  ·  q back")
        try:
            stdscr.addstr(0, 0, hdr[:w - 1],
                          curses.color_pair(CP_HDR) | curses.A_BOLD)
        except curses.error:
            pass

        list_h = h - 3
        if not entries:
            try:
                stdscr.addstr(2, 2, "no memories stored yet  —  press a to add one",
                              curses.color_pair(CP_DIM) | curses.A_DIM)
            except curses.error:
                pass
        else:
            last_section = None
            row = 1
            for i, (sec, key, text, src) in enumerate(entries):
                if row >= list_h:
                    break
                # Section header
                if sec != last_section:
                    if last_section is not None:
                        row += 1   # blank line between sections
                    try:
                        lbl = f"  ── {SECTION_LABELS[sec]} "
                        lbl = lbl + "─" * max(0, w - len(lbl) - 1)
                        stdscr.addstr(row, 0, lbl[:w - 1],
                                      curses.color_pair(CP_DIM) | curses.A_DIM)
                    except curses.error:
                        pass
                    row += 1
                    last_section = sec

                if row >= list_h:
                    break

                is_cur = (i == cur)
                cp     = CP_PIN if sec == "pinned" else CP_LRN
                tag    = f"({src}) " if src else ""
                line   = f"  {'▶' if is_cur else ' '}  {tag}{text}"
                if is_cur:
                    attr = curses.color_pair(CP_CUR) | curses.A_BOLD | curses.A_REVERSE
                else:
                    attr = curses.color_pair(cp)
                try:
                    stdscr.addstr(row, 0, line[:w - 1], attr)
                except curses.error:
                    pass
                row += 1

        # Footer
        try:
            stdscr.addstr(h - 2, 0, "─" * (w - 1),
                          curses.color_pair(CP_DIM) | curses.A_DIM)
            n_pin = len(_memory)
            n_lrn = len(_learned)
            footer = f"  {n_pin} pinned  ·  {n_lrn} learned"
            stdscr.addstr(h - 1, 0, footer[:w - 1],
                          curses.color_pair(CP_DIM) | curses.A_DIM)
        except curses.error:
            pass

        stdscr.noutrefresh()
        curses.doupdate()

    stdscr.keypad(True)
    curses.curs_set(0)

    while True:
        entries = _entries()
        if cur >= len(entries):
            cur = max(0, len(entries) - 1)
        draw(entries)

        ch = stdscr.getch()
        h, w = stdscr.getmaxyx()

        if ch == curses.KEY_RESIZE:
            continue

        elif ch in (ord('q'), ord('Q'), 27):
            curses.curs_set(1)
            return

        elif ch == curses.KEY_UP:
            cur = max(0, cur - 1)

        elif ch == curses.KEY_DOWN:
            cur = min(max(0, len(entries) - 1), cur + 1)

        elif ch in (curses.KEY_HOME, 1):
            cur = 0

        elif ch in (curses.KEY_END, 5):
            cur = max(0, len(entries) - 1)

        elif ch in (ord('d'), ord('D')) and entries:
            sec, key, text, _ = entries[cur]
            store = _memory if sec == "pinned" else _learned
            q = f"  delete: '{text[:w - 20]}'?  [y/N]:  "
            try:
                stdscr.move(h - 1, 0)
                stdscr.clrtoeol()
                stdscr.addstr(h - 1, 0, q[:w - 1],
                              curses.color_pair(CP_ERR) | curses.A_BOLD)
                stdscr.noutrefresh()
                curses.doupdate()
            except curses.error:
                pass
            answer = _inline_input(stdscr, h - 1, len(q), w)
            if answer.lower() == 'y':
                del store[key]
                _save_memory_file()
                cur = max(0, cur - 1)
            curses.curs_set(0)

        elif ch in (ord('e'), ord('E')) and entries:
            sec, key, text, _ = entries[cur]
            store = _memory if sec == "pinned" else _learned
            prompt = "  edit:  "
            try:
                stdscr.move(h - 1, 0)
                stdscr.clrtoeol()
                stdscr.addstr(h - 1, 0, prompt[:w - 1],
                              curses.color_pair(CP_CUR) | curses.A_BOLD)
                stdscr.noutrefresh()
                curses.doupdate()
            except curses.error:
                pass
            # Pre-fill with current text by inserting it into the inline input
            new_text = _inline_input_prefill(stdscr, h - 1, len(prompt), w, text)
            if new_text and new_text != text:
                if sec == "pinned":
                    store[key] = new_text.strip()
                else:
                    if isinstance(store[key], dict):
                        store[key]["fact"] = new_text.strip()
                    else:
                        store[key] = new_text.strip()
                _save_memory_file()
            curses.curs_set(0)

        elif ch in (ord('a'), ord('A')):
            # Ask which section first if there's room, then get the text
            section_ch = _ui.choose(("Pinned fact", "Learned fact"), default=0) if _ui else "Pinned fact"
            sec = "learned" if section_ch and "Learned" in section_ch else "pinned"
            prompt = f"  add to {sec}:  "
            try:
                stdscr.move(h - 1, 0)
                stdscr.clrtoeol()
                stdscr.addstr(h - 1, 0, prompt[:w - 1],
                              curses.color_pair(CP_CUR) | curses.A_BOLD)
                stdscr.noutrefresh()
                curses.doupdate()
            except curses.error:
                pass
            new_text = _inline_input(stdscr, h - 1, len(prompt), w)
            if new_text and new_text.strip():
                if sec == "pinned":
                    _pin_fact(new_text.strip())
                else:
                    _learn_fact(new_text.strip(), source="manual")
                cur = len(_entries()) - 1   # jump to newly added entry
            curses.curs_set(0)


# ── Session manager (full-screen curses) ──────────────────────────────────────

def session_manager(stdscr):
    """
    Full-screen session browser.
    Keys: ↑↓ navigate · space select · a select-all · enter load
          r rename · d delete selected (or cursor) · q back
    Returns (sess_name, messages) if a session was loaded, else (None, None).
    """
    def _load_sessions():
        # Load each session's metadata once here rather than on every redraw —
        # draw() runs after nearly every keypress (arrow keys, selection, etc).
        entries = [(p.stem, p) for p in SESS_DIR.iterdir() if p.suffix == ".jsonl"]
        out = []
        for name, path in entries:
            label, updated = _load_session_meta(path)
            out.append((name, path, label, updated))
        out.sort(key=lambda x: x[3], reverse=True)
        return out

    sessions = _load_sessions()
    selected = set()
    cursor   = 0

    CP_HDR  = 2   # reuse TUI.CP_STATUS pair
    CP_SEL  = 5   # green for selected
    CP_CUR  = 8   # cyan+reverse for cursor
    CP_NORM = 1
    CP_DIM  = 7
    CP_ERR  = 6

    def draw():
        h, w = stdscr.getmaxyx()
        stdscr.erase()

        # ── header ──
        hdr = ("  SESSION MANAGER  ·  ↑↓ nav  ·  space sel  "
               "·  a all  ·  enter load  ·  r rename  ·  d delete  ·  q back")
        try:
            stdscr.addstr(0, 0, hdr[:w - 1],
                          curses.color_pair(CP_HDR) | curses.A_BOLD)
        except curses.error:
            pass

        list_h = h - 3
        for i, (name, path, label, updated) in enumerate(sessions):
            if i >= list_h:
                break
            rel   = _relative_time(updated)
            display = label if label else name[:36]
            marker = "◆" if i in selected else "◇"
            line   = f"  {marker}  {display:<38}  {rel:<12}"
            is_cur = (i == cursor)

            if is_cur:
                attr = curses.color_pair(CP_CUR) | curses.A_BOLD | curses.A_REVERSE
            elif i in selected:
                attr = curses.color_pair(CP_SEL) | curses.A_BOLD
            else:
                attr = curses.color_pair(CP_NORM)

            try:
                stdscr.addstr(i + 1, 0, line[:w - 1], attr)
            except curses.error:
                pass

        # ── footer ──
        try:
            stdscr.addstr(h - 2, 0, "─" * (w - 1),
                          curses.color_pair(CP_DIM) | curses.A_DIM)
            footer = (f"  {len(sessions)} sessions"
                      + (f"  ·  {len(selected)} selected" if selected else ""))
            stdscr.addstr(h - 1, 0, footer[:w - 1],
                          curses.color_pair(CP_DIM) | curses.A_DIM)
        except curses.error:
            pass

        if not sessions:
            try:
                stdscr.addstr(2, 2, "no saved sessions",
                              curses.color_pair(CP_DIM) | curses.A_DIM)
            except curses.error:
                pass

        stdscr.noutrefresh()
        curses.doupdate()

    stdscr.keypad(True)
    curses.curs_set(0)
    draw()

    while True:
        ch = stdscr.getch()
        h, w = stdscr.getmaxyx()

        if ch == curses.KEY_RESIZE:
            draw()

        elif ch in (ord('q'), ord('Q'), 27):
            curses.curs_set(1)
            return None, None

        elif ch == curses.KEY_UP:
            cursor = max(0, cursor - 1)
            draw()

        elif ch == curses.KEY_DOWN:
            cursor = min(max(0, len(sessions) - 1), cursor + 1)
            draw()

        elif ch == ord(' '):
            if cursor in selected:
                selected.discard(cursor)
            else:
                selected.add(cursor)
            cursor = min(cursor + 1, max(0, len(sessions) - 1))
            draw()

        elif ch in (ord('a'), ord('A')):
            if len(selected) == len(sessions):
                selected.clear()
            else:
                selected = set(range(len(sessions)))
            draw()

        elif ch in (curses.KEY_ENTER, ord('\n'), ord('\r')):
            if not sessions:
                continue
            name = sessions[cursor][0]
            curses.curs_set(1)
            n, msgs = load_session_messages(name)
            return n, msgs

        elif ch in (ord('r'), ord('R')):
            if not sessions:
                continue
            name, path = sessions[cursor][0], sessions[cursor][1]
            prompt_text = f"  rename  '{name}'  →  "
            try:
                stdscr.move(h - 1, 0)
                stdscr.clrtoeol()
                stdscr.addstr(h - 1, 0, prompt_text[:w - 1],
                              curses.color_pair(CP_CUR) | curses.A_BOLD)
                stdscr.noutrefresh()
                curses.doupdate()
            except curses.error:
                pass
            new_name = _inline_input(stdscr, h - 1, len(prompt_text), w)
            if new_name and new_name != name:
                new_path = SESS_DIR / f"{new_name}.jsonl"
                try:
                    path.rename(new_path)
                    label, updated = _load_session_meta(new_path)
                    sessions[cursor] = (new_name, new_path, label, updated)
                except Exception as e:
                    try:
                        stdscr.addstr(h - 1, 0, f"  rename failed: {e}"[:w - 1],
                                      curses.color_pair(CP_ERR))
                        stdscr.noutrefresh(); curses.doupdate()
                        time.sleep(1.5)
                    except curses.error:
                        pass
            curses.curs_set(0)
            draw()

        elif ch in (ord('d'), ord('D')):
            if not sessions:
                continue
            to_delete = sorted(selected if selected else {cursor}, reverse=True)
            names     = [sessions[i][0] for i in to_delete if i < len(sessions)]
            if len(names) == 1:
                q = f"  delete  '{names[0]}'?  [y/N]:  "
            else:
                q = f"  delete {len(names)} sessions?  [y/N]:  "
            try:
                stdscr.move(h - 1, 0)
                stdscr.clrtoeol()
                stdscr.addstr(h - 1, 0, q[:w - 1],
                              curses.color_pair(CP_ERR) | curses.A_BOLD)
                stdscr.noutrefresh()
                curses.doupdate()
            except curses.error:
                pass
            answer = _inline_input(stdscr, h - 1, len(q), w)
            if answer.lower() == 'y':
                for i in sorted(to_delete, reverse=True):
                    if i < len(sessions):
                        try:
                            sessions[i][1].unlink()
                        except Exception:
                            pass
                        sessions.pop(i)
                selected.clear()
                cursor = min(cursor, max(0, len(sessions) - 1))
            curses.curs_set(0)
            draw()


# ── Query complexity + auto model selection ────────────────────────────────────

_COMPLEX_RE = re.compile(
    r'\b(write|create|generate|implement|build|develop|script|function|class|'
    r'fix|debug|refactor|optimize|edit|modify|update|'
    r'analyze|analyse|compare|design|architect|'
    r'why does|how does|what causes|walk me through|step.by.step)\b',
    re.IGNORECASE
)

def _classify(text, has_file=False):
    """Return 'fast' or 'full' based on query complexity."""
    if has_file:               return "full"
    if len(text.split()) > 60: return "full"
    if _COMPLEX_RE.search(text): return "full"
    return "fast"

_model_cache      = None   # cached result of _light_model()
_model_cache_ts   = 0.0
_use_serper       = False  # DDG by default; toggled by /serper
_deep_think       = False  # prepend [DEEP THINK] to queries when ON
_cal_events       = []     # cached calendar event lines (background-fetched)
_cal_ts           = 0.0    # timestamp of last successful calendar fetch
_memory           = {}     # persistent facts from /pin
_learned          = {}     # auto-learned corrections and /learn facts
_mood             = "default"   # personality mood
