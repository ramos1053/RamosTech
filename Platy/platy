def _is_writing_task(text):
    """True when the user wants text edited/rewritten — skip web search for these."""
    return bool(_WRITING_RE.search(text))

_QUESTION_LEAD = re.compile(
    r'^\s*(?:what|when|where|who|why|how|is|are|can|could|would|should|do|does|did|will)\b',
    re.IGNORECASE
)
_COMMAND_LEAD = re.compile(
    r'^\s*(?:write|create|fix|generate|make|build|run|show|list|find|search|'
    r'explain|describe|translate|summarize|summarise|give|tell|help|check|update|add|remove)\b',
    re.IGNORECASE
)

def _is_pasted_prose(text):
    """True when the input looks like pasted text to work on (multi-line prose),
    rather than a direct question, command, or instruction."""
    if '\n' not in text or len(text) < 80 or text.startswith('/'):
        return False
    first = text.split('\n')[0].strip()
    if _QUESTION_LEAD.match(first) or first.endswith('?'):
        return False
    if _COMMAND_LEAD.match(first):
        return False
    return True

