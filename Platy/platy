        try:
            user_input = _ui.get_input()
        except KeyboardInterrupt:
            _ui.add("")
            _ui.add("  (interrupted — type /exit to quit)", TUI.CP_INFO)
            continue

        if user_input is None:   # Ctrl+D
            break
        if not user_input:
            continue

        # ── commands ──────────────────────────────────────────────────────────

        if user_input == "/exit":
