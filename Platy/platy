_watched_files    = {}     # {path_str: mtime} for /watch

# Self-awareness state — updated by _tui_main so _sys_ctx() can report them
_platy_model      = DEFAULT_MODEL   # currently active model name
_platy_session    = ""              # current session name

MEMORY_FILE = Path.home() / ".platy_memory.json"

MOODS = {
    "default":  "",
    "focused":  "Be professional and terse. Prioritize clarity and brevity above all.",
    "playful":  "Be extra witty and fun. Lean into banter and light humor throughout.",
    "direct":   "Be blunt and minimal. No fluff. Bullet points are acceptable in this mode.",
}

_REASONING_MODEL_TAGS = ("deepseek-r1", "deepseek-r2", "deepseek-coder")
# Reasoning-specialist models (chain-of-thought focused) should not be used as
# the fast chat model — they tend to ignore format instructions and produce
# structured lists regardless of system-prompt guidance.

def _light_model():
    """Return the fastest local (ollama) model, with a 60-second cache.
    Prefers small general-chat models; avoids reasoning specialists.
    Never auto-selects Claude — that requires explicit /model selection."""
    global _model_cache, _model_cache_ts
    if _model_cache and time.time() - _model_cache_ts < 60:
        return _model_cache
    # Only consider local models (no claude- prefix)
    names = [n for n, _ in get_models() if not n.startswith("claude-")]
    if not names:
        _model_cache = DEFAULT_MODEL
    else:
        _LIGHT_TAGS = ("1b", "3b", "phi", "tiny", "mini", "small", "7b", "8b")
        # Pass 1: small general-chat model (not a reasoning specialist)
        for n in names:
            nl = n.lower()
            if (any(x in nl for x in _LIGHT_TAGS) and
                    not any(r in nl for r in _REASONING_MODEL_TAGS)):
                _model_cache = n
                break
        else:
            # Pass 2: any small model including reasoning ones
            for n in names:
                if any(x in n.lower() for x in _LIGHT_TAGS):
                    _model_cache = n
                    break
            else:
                _model_cache = names[0]
    _model_cache_ts = time.time()
    return _model_cache

_SMALL_MODEL_TAGS = ("1b", "3b", "7b", "8b", "phi", "tiny", "mini", "small")

def _is_small_model(name):
    """True for lightweight models that benefit from a shorter system prompt."""
    n = name.lower()
    return any(t in n for t in _SMALL_MODEL_TAGS)

def _prompt_for(model_name):
    """Return the most appropriate system prompt for this model's capability."""
    if model_name.startswith("claude-") or not _is_small_model(model_name):
        return SYSTEM_PROMPT
    return SHORT_SYSTEM_PROMPT

_UPGRADE_RE = re.compile(r'UPGRADE_NEEDED\s*\nreason:\s*(.+)', re.IGNORECASE)

def _next_capable_model(current):
    """Return the best available LOCAL model more capable than current. Never Claude."""
    all_models = [n for n, _ in get_models()]
    # Local non-small models first, excluding current
    capable = [n for n in all_models
               if not _is_small_model(n) and not n.startswith("claude-") and n != current]
    if capable:
        return capable[0]
    # Any local model that isn't current (still better than nothing)
    others = [n for n in all_models if not n.startswith("claude-") and n != current]
    if others:
        return others[0]
    # No local upgrade available — caller must handle Claude separately with confirmation
    return None

def _claude_upgrade_model():
    """Return the best Claude model available, or None."""
    for n, _ in get_models():
        if n.startswith("claude-sonnet"):
            return n
    for n, _ in get_models():
        if n.startswith("claude-"):
            return n
    return None


# ── Agent delegation ───────────────────────────────────────────────────────────

_DELEGATE_RE = re.compile(
    r'^DELEGATE_START\s*\ntask:\s*(.+?)\nDELEGATE_END',
    re.MULTILINE | re.DOTALL
)

def _run_delegate(task):
    """
    Run a silent, isolated sub-agent call on the fast model.
    Not displayed, not saved to session. Returns result string.
    """
    msgs = [
        {"role": "system",
         "content": ("You are a focused sub-agent. Answer the task concisely and precisely. "
                     "Plain text only, no markdown.")},
        {"role": "user", "content": task},
    ]
    _, result = ask(msgs, _light_model(), silent=True)
    return result.strip() or "(no result)"


def _run_parallel_delegates(tasks):
    """Run delegate tasks concurrently. Returns list of (task, result) tuples."""
    if len(tasks) == 1:
        return [(tasks[0], _run_delegate(tasks[0]))]
    results = {}
    with ThreadPoolExecutor(max_workers=min(len(tasks), 4)) as pool:
        futures = {pool.submit(_run_delegate, t): t for t in tasks}
        for future in as_completed(futures):
            t = futures[future]
            try:
                results[t] = future.result()
            except Exception as e:
                results[t] = f"(error: {e})"
    return [(t, results[t]) for t in tasks]


# ── Shell agent ────────────────────────────────────────────────────────────────

_SHELL_RE = re.compile(
    r'^SHELL_START\s*\ncmd:\s*(.+?)\nSHELL_END',
    re.MULTILINE | re.DOTALL
)

def _run_shell_agent(cmd, timeout=30):
    """Execute a shell command after user approval. Returns output string."""
    print_info(f"  shell agent ▸  {cmd[:80]}")
    if _ui:
        answer = _ui.choose(("Run", "Skip"), default=1)
    else:
        try:
            raw = input("  run this command? [y/N]: ").strip().lower()
            answer = "Run" if raw == "y" else "Skip"
        except (EOFError, KeyboardInterrupt):
            print()
            return "(cancelled)"
    if answer != "Run":
        return "(user skipped)"
    try:
        proc = subprocess.run(
            cmd, shell=True, capture_output=True, text=True,
            timeout=timeout, cwd=str(Path.home())
        )
        out = (proc.stdout + proc.stderr).strip()
        if len(out) > 2000:
            out = out[:2000] + "\n…(truncated)"
        return out or "(no output)"
    except subprocess.TimeoutExpired:
        return f"(timeout after {timeout}s)"
    except Exception as e:
        return f"(error: {e})"


# ── Specialized / iterative agents ────────────────────────────────────────────

_AGENT_RE = re.compile(
    r'^AGENT_START\s*\nrole:\s*(\w+)\s*\ntask:\s*(.+?)\nAGENT_END',
    re.MULTILINE | re.DOTALL
)

_AGENT_TOOL_RE = re.compile(
    r'^TOOL_CALL\s*\ntype:\s*(\w+)\s*\ninput:\s*(.+?)\nTOOL_END',
    re.MULTILINE | re.DOTALL
)

_FINAL_ANSWER_RE = re.compile(
    r'^FINAL_ANSWER:\s*(.+)',
    re.MULTILINE | re.DOTALL
)

_AGENT_ROLE_PROMPTS = {
    "researcher": (
        "You are a research agent. Answer a specific task using tools when needed.\n\n"
        "TOOLS:\n"
        "  TOOL_CALL\n  type: web_search\n  input: your search query\n  TOOL_END\n\n"
        "  TOOL_CALL\n  type: delegate\n  input: a specific question for another LLM\n  TOOL_END\n\n"
        "When done:\n  FINAL_ANSWER: your complete answer\n\n"
        "Rules: plain text only. Use tools for current or external info. Think step by step."
    ),
    "coder": (
        "You are a coding agent. Write, fix, or explain code as requested.\n\n"
        "TOOLS:\n"
        "  TOOL_CALL\n  type: delegate\n  input: a syntax or API question\n  TOOL_END\n\n"
        "When done:\n  FINAL_ANSWER: your code or explanation\n\n"
        "Rules: for complete scripts use SCRIPT_START/SCRIPT_END. Think before coding."
    ),
    "executor": (
        "You are an executor agent. Complete a task by running shell commands.\n\n"
        "TOOLS:\n"
        "  TOOL_CALL\n  type: shell\n  input: the shell command\n  TOOL_END\n\n"
        "When done:\n  FINAL_ANSWER: summary of what was done and the results\n\n"
        "Rules: one command per TOOL_CALL. The user approves each command. Plan before acting."
    ),
    "analyst": (
        "You are an analyst agent. Reason through a problem and produce a clear conclusion.\n"
        "No external tools — use only your knowledge and reasoning.\n\n"
        "When done:\n  FINAL_ANSWER: your analysis and conclusion\n\n"
        "Rules: think step by step, consider multiple angles, give a clear verdict."
    ),
}


def _run_iterative_agent(role, task, model, max_steps=5):
    """Run an autonomous multi-step agent loop. Returns the final answer string."""
    sys_p = _AGENT_ROLE_PROMPTS.get(role, _AGENT_ROLE_PROMPTS["analyst"])
    msgs  = [
        {"role": "system", "content": sys_p},
        {"role": "user",   "content": task},
    ]
    resp = ""
    for _ in range(max_steps):
        _, resp = ask(msgs, model, silent=True)

        fa = _FINAL_ANSWER_RE.search(resp)
        if fa:
            return fa.group(1).strip()

        tm = _AGENT_TOOL_RE.search(resp)
        if not tm:
            return resp.strip()

        tool_type  = tm.group(1).strip().lower()
        tool_input = tm.group(2).strip()
        msgs.append({"role": "assistant", "content": resp})

        if tool_type == "web_search":
            result_str, _ = web_search(tool_input)
            tool_result   = result_str or "(no results)"
        elif tool_type == "shell":
            tool_result = _run_shell_agent(tool_input)
        elif tool_type == "delegate":
            tool_result = _run_delegate(tool_input)
        else:
            tool_result = f"(unknown tool: {tool_type})"

        msgs.append({
            "role": "user",
            "content": f"[TOOL RESULT: {tool_type}]: {tool_result}\n\nContinue.",
        })

    return resp.strip() if resp else "(agent reached step limit)"


# ── Output helpers (TUI-aware) ─────────────────────────────────────────────────

def _is_ssh():
    return bool(os.getenv("SSH_CLIENT") or os.getenv("SSH_TTY")
                or os.getenv("SSH_CONNECTION"))

def _copy_to_clipboard(text):
    """
    Copy text to the user's clipboard.
    - Local session → pbcopy (macOS native)
    - SSH session   → returns False so the caller can suspend curses and
                      print the response as selectable plain text instead.
    Returns (success: bool, method: str).
    """
    if not _is_ssh():
        try:
            proc = subprocess.run(["pbcopy"], input=text.encode(), timeout=3)
            return proc.returncode == 0, "pbcopy"
        except Exception:
            return False, ""
    return False, "ssh"


def print_user(text):
    if _ui:
        _ui.add("")
        pr = getattr(_ui, '_last_paste_range', None)
        if pr is not None:
            ps, pe       = pr
            pre          = text[:ps]
            pasted       = text[ps:pe]
            post         = text[pe:]
            n_words      = len(pasted.split())
            n_lines      = pasted.count("\n") + 1
            label        = f"[Pasted text · {n_words} words · {n_lines} lines]"
            display      = pre + label + post
            preview      = (display[:72] + "…") if len(display) > 72 else display
            _ui.add(f"you  ▸  {preview}", TUI.CP_USER, bold=True)
        elif "\n" in text:
            n_lines = text.count("\n") + 1
            n_words = len(text.split())
            _ui.add(f"you  ▸  [Pasted text · {n_words} words · {n_lines} lines]", TUI.CP_USER, bold=True)
        else:
            preview = (text[:72] + "…") if len(text) > 72 else text
            _ui.add(f"you  ▸  {preview}", TUI.CP_USER, bold=True)
        _ui.add("")
    else:
        display = text.replace("\n", " ")
        preview = (display[:80] + "…") if len(display) > 80 else display
        print(f"\n{ORANGE}{BOLD}you{R} {DGRAY}▸{R}  {preview}\n")

def print_info(msg):
    if _ui:
        _ui.add(f"  {msg}", TUI.CP_INFO)
    else:
        print(f"  {DGRAY}{msg}{R}")

def print_ok(msg):
    if _ui:
        _ui.add(f"  ✓  {msg}", TUI.CP_OK)
    else:
        print(f"  {GREEN}✓{R}  {msg}")

def print_err(msg):
    if _ui:
        _ui.add(f"  ✗  {msg}", TUI.CP_ERR)
    else:
        print(f"\n  {RED}✗{R}  {msg}\n", file=sys.stderr)

def rule():
    if _ui:
        _ui.add("─" * min(60, max(10, _ui._w - 4)), TUI.CP_INFO)
    else:
        try:    w = os.get_terminal_size().columns
        except: w = 80
        print(f"{DGRAY}{'─' * w}{R}")

def show_sources(sources):
    """Store sources from last web search silently — use /sources to display them."""
    global _last_sources
    _last_sources = list(sources) if sources else []

def display_sources():
    """Display the sources from the last web search (called by /sources command)."""
    if not _last_sources:
        print_info("no sources from the last search")
        return
    if _ui:
        _ui.add("")
        _ui.add("  sources:", TUI.CP_CYAN, bold=True)
        for i, (title, url) in enumerate(_last_sources, 1):
            _ui.add(f"  [{i}] {title}", TUI.CP_INFO)
            short_url = url if len(url) <= 90 else url[:87] + "…"
            _ui.add(f"       {short_url}", TUI.CP_CYAN)
        _ui.add("")
    else:
        print(f"\n  {CYAN}sources:{R}")
        for i, (title, url) in enumerate(_last_sources, 1):
            print(f"  {i}.  {title}")
            print(f"       {CYAN}{url}{R}")
        print()


# ── Diff colorization ─────────────────────────────────────────────────────────

_DIFF_ADD_RE = re.compile(r'^\+(?!\+\+)')
# Diff deletion: '-' immediately followed by non-space/non-dash content.
# Markdown bullets ("- item") start with "- " and must NOT be colored red.
_DIFF_DEL_RE = re.compile(r'^-(?![-\s])')

def _diff_style(text):
    """
    Detect unified-diff line prefixes and return (tui_cp, ansi_code).
    + line  → green addition
    - line  → red deletion
    @@ ...  → cyan hunk header
    anything else → normal AI color
    """
    if _DIFF_ADD_RE.match(text):  return TUI.CP_OK,   GREEN
    if _DIFF_DEL_RE.match(text):  return TUI.CP_ERR,  RED
    if text.startswith('@@'):     return TUI.CP_CYAN, CYAN
    return TUI.CP_AI, ""

_CONF_TAG_RE = re.compile(r'^\[(C|U|K)\]\s*')

def _strip_confidence_tag(text):
    """Strip a leading [C]/[U]/[K] confidence tag from a line.
    Returns (tui_cp_or_None, ansi_or_None, text_with_tag_removed).
    [C] → green  (confident, fact-checked)
    [U] → yellow (uncertain, user should verify)
    [K] → red    (suspected Platypus Fallacy / likely wrong)
    """
    m = _CONF_TAG_RE.match(text)
    if not m:
        return None, None, text
    tag      = m.group(1)
    stripped = text[m.end():]
    if tag == 'C':
        return TUI.CP_OK,   GREEN,  stripped
    if tag == 'U':
        return TUI.CP_WARN, YELLOW, stripped
    return TUI.CP_ERR, RED, stripped


# ── System context ────────────────────────────────────────────────────────────

def _read_calendar_fs():
    """Read upcoming events from macOS Calendar SQLite DB (no permissions required)."""
    db = (Path.home() / "Library" / "Group Containers" /
          "group.com.apple.calendar" / "Calendar.sqlitedb")
    if not db.exists():
        return []
    # CoreData epoch: seconds since 2001-01-01 UTC
    EPOCH  = datetime(2001, 1, 1, tzinfo=timezone.utc)
    now    = datetime.now(timezone.utc)
    cutoff = now + timedelta(days=2)
    now_cd    = (now    - EPOCH).total_seconds()
    cutoff_cd = (cutoff - EPOCH).total_seconds()
    events = []
    con = None
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
        cur = con.cursor()
        cur.execute(
            "SELECT summary, start_date, all_day FROM CalendarItem "
            "WHERE start_date >= ? AND start_date < ? ORDER BY start_date LIMIT 20",
            (now_cd, cutoff_cd),
        )
        for summary, start_cd, all_day in cur.fetchall():
            if not summary:
                continue
            dt    = (EPOCH + timedelta(seconds=start_cd)).astimezone()
            label = "all day" if all_day else dt.strftime("%-I:%M %p")
            events.append(f"{summary.strip()} @ {dt.strftime('%a %b %-d')} {label}".strip())
    except Exception:
        pass
    finally:
        if con is not None:
            con.close()
    return events

def _refresh_calendar():
    """Fetch upcoming calendar events from local SQLite DB; no permissions required."""
    global _cal_events, _cal_ts
    try:
        lines = _read_calendar_fs()
        if lines:
            _cal_events = lines
            _cal_ts     = time.time()
    except Exception:
        pass

def _ensure_calendar(force=False):
    """Refresh calendar cache in background. Never blocks startup."""
    if force or time.time() - _cal_ts > 300:
        threading.Thread(target=_refresh_calendar, daemon=True).start()

def _sys_ctx():
    """
    Build the live system-context string injected at the top of every ask().
    Covers: platy identity, current date/time, host info, calendar, memory, mood.
    """
    now = datetime.now().astimezone()
    mac_ver = platform.mac_ver()[0]
    os_str  = f"macOS {mac_ver}" if mac_ver else platform.system()

    lines = [
        "SYSTEM CONTEXT (live, injected automatically — do not ask the user to provide this):",
        # ── App identity (self-awareness) ───────────────────────────────────────
        f"  app       : PLATY — local AI terminal console",
        f"  ai model  : {_platy_model}",
        f"  features  : web search · Apple docs"
        + (f" · {DOCS_NAME} docs" if DOCS_NAME else "")
        + " · memory · scripting · sessions",
    ]
    if _deep_think:
        lines.append("  deep think: ACTIVE — maximum reasoning mode is ON")
    if _mood != "default" and MOODS.get(_mood):
        lines.append(f"  mood      : {MOODS[_mood]}")
    if _platy_session:
        lines.append(f"  session   : {_platy_session}")

    # ── Live environment ────────────────────────────────────────────────────────
    lines += [
        f"  date/time : {now.strftime('%A, %B %-d %Y  %-I:%M %p')} {now.strftime('%Z')}",
        f"  hostname  : {socket.gethostname()}",
        f"  user      : {os.getenv('USER', os.getenv('LOGNAME', 'unknown'))}",
        f"  os        : {os_str}",
    ]

    # ── Calendar events ─────────────────────────────────────────────────────────
    if _cal_events:
        lines.append("  calendar  : upcoming events:")
        for ev in _cal_events:
            lines.append(f"              {ev}")

    # ── Persistent memory ───────────────────────────────────────────────────────
    if _memory:
        lines.append("  memory    : things the user has told you:")
        for fact in list(_memory.values())[:10]:
            lines.append(f"              {fact}")
    if _learned:
        lines.append("  learned   : corrections and facts from experience:")
        for v in list(_learned.values())[:15]:
            fact = v["fact"] if isinstance(v, dict) else v
            lines.append(f"              {fact}")

    return "\n".join(lines)


# ── AI streaming ──────────────────────────────────────────────────────────────

def ask(messages, model, silent=False, strip_phantom_cites=False):
    """Stream a completion from ollama or Claude. Returns (raw_text, cleaned_text).
    silent=True suppresses all output and the spinner (used for delegate calls).
    strip_phantom_cites=True removes inline [N] citation markers and hallucinated
    citation language when no web search was performed for this turn."""
    # Keep self-awareness current so _sys_ctx() reports the right model name.
    # Skip on silent delegate calls — those run on a sub-model, not the main one.
    if not silent:
        global _platy_model
        _platy_model = model

    # Select the right system prompt for this model's capability, then inject live context
    if messages and messages[0].get("role") == "system":
        base_prompt = _prompt_for(model)
        ctx = (
            _sys_ctx() +
            "\nIMPORTANT: The SYSTEM CONTEXT above is live and accurate. "
            "Use it to answer questions about the current time, date, or calendar events "
            "instead of guessing or asking the user to check elsewhere.\n"
        )
        messages = [{"role": "system", "content": ctx + "\n" + base_prompt}] + messages[1:]

    buf           = []
    raw_parts     = []
    cleaned_lines = []
    in_think      = False

    # ── spinner (skipped when silent) ─────────────────────────────────────────
    _stop_spinner    = threading.Event()
    _spinner_cleared = silent   # pre-cleared when silent so _clear_spinner is a no-op

    if not silent:
        def _spinner_fn():
            t0 = time.time(); i = 0
            while not _stop_spinner.is_set():
                elapsed = int(time.time() - t0)
                dot  = "●" if (i // 4) % 2 == 0 else " "
                note = "  working hard…" if elapsed >= 30 else ""
                if _ui:
                    _ui.spin_update(f"{dot}  thinking  {elapsed}s{note}")
                else:
                    color = RED if elapsed >= 30 else ORANGE
                    dot_c = f"{color}{dot}{R}" if dot == "●" else dot
                    print(f"\r  {dot_c}  {DGRAY}thinking  {elapsed}s{note}{R}   ",
                          end="", flush=True)
                i += 1
                _stop_spinner.wait(0.12)
            if _ui:
                _ui.spin_stop()
            else:
                print(f"\r{' ' * 60}\r", end="", flush=True)

        _spin = threading.Thread(target=_spinner_fn, daemon=True)
        _spin.start()
    else:
        _spin = None

    def _clear_spinner():
        nonlocal _spinner_cleared
        if not _spinner_cleared:
            _spinner_cleared = True
            _stop_spinner.set()
            _spin.join()

    # ── line processor ─────────────────────────────────────────────────────────

    def flush_line(line):
        nonlocal in_think
        if "<think>"  in line: in_think = True;  return None
        if "</think>" in line: in_think = False; return None
        if in_think:           return None
        # Strip confidence tag before any other processing so it never
        # reaches session storage or phantom-cite stripping.
        conf_cp, conf_ansi, line = _strip_confidence_tag(line)
        cleaned = strip_line(line)
        if strip_phantom_cites and cleaned:
            cleaned = _PHANTOM_CITE_RE.sub('', cleaned)
            cleaned = _PHANTOM_LANG_RE.sub('', cleaned).strip()
            line = cleaned   # keep display consistent with what gets stored
        if cleaned is not None and not silent:
            if conf_cp is not None:
                cp, ansi = conf_cp, conf_ansi
            else:
                cp, ansi = _diff_style(cleaned)
            if _ui:
                # Send the tag-stripped line so the TUI renders clean text
                # with the correct confidence colour applied.
                _ui.add(line, cp)
            else:
                print(f"{ansi}{cleaned}{R}" if ansi else f"  {cleaned}")
        return cleaned

    def _ingest(token):
        nonlocal buf
        if token:
            _clear_spinner()
        raw_parts.append(token)
        for ch in token:
            if ch == "\n":
                line = "".join(buf); buf = []
                result = flush_line(line)
                if result is not None:
                    cleaned_lines.append(result)
            else:
                buf.append(ch)

    def _flush_buf():
        if buf:
            result = flush_line("".join(buf))
            if result is not None:
                cleaned_lines.append(result)

    # ── API calls ──────────────────────────────────────────────────────────────

    try:
        if model.startswith("claude-"):
            if not ANTHROPIC_KEY:
                print_err("ANTHROPIC_API_KEY is not set — add it to ~/.zshrc")
                _clear_spinner()
                return "", ""
            system   = next((m["content"] for m in messages if m["role"] == "system"), "")
            api_msgs = [m for m in messages if m["role"] != "system"]
            body = json.dumps({
                "model": model, "max_tokens": 8192, "system": system,
                "messages": api_msgs, "stream": True,
            }).encode()
            req = Request(
                "https://api.anthropic.com/v1/messages", data=body,
                headers={"x-api-key": ANTHROPIC_KEY,
                         "anthropic-version": "2023-06-01",
                         "content-type": "application/json"},
            )
            with urlopen(req, timeout=180) as resp:
                for raw_line in resp:
                    line = raw_line.decode().strip()
                    if not line.startswith("data:"):
                        continue
                    data_str = line[5:].strip()
                    if data_str == "[DONE]":
                        break
                    try:
                        chunk = json.loads(data_str)
                    except json.JSONDecodeError:
                        continue
                    if chunk.get("type") == "content_block_delta":
                        delta = chunk.get("delta", {})
                        if delta.get("type") == "text_delta":
                            _ingest(delta.get("text", ""))
                    elif chunk.get("type") == "message_stop":
                        break
            _flush_buf()

        else:
            body = json.dumps({
                "model": model, "messages": messages, "stream": True,
            }).encode()
            req = Request(f"{API_BASE}/api/chat", data=body,
                          headers={"Content-Type": "application/json"})
            with urlopen(req, timeout=180) as resp:
                for raw in resp:
                    chunk = json.loads(raw.decode())
                    _ingest(chunk.get("message", {}).get("content", ""))
                    if chunk.get("done"):
                        _flush_buf()
                        break

        if _ui:
            _ui.redraw()   # guarantee the last streamed line(s) are visible, even mid-throttle-window
        _clear_spinner()
        if not _ui and not silent:
            print(R, end="", flush=True)

    except HTTPError as e:
        _clear_spinner()
        if not silent:
            try:
                msg = json.loads(e.read().decode()).get("error", {}).get("message", str(e))
            except Exception:
                msg = str(e)
            print_err(f"API error: {msg}")
        return "", ""

    except URLError as e:
        _clear_spinner()
        if not silent:
            target = "Claude API" if model.startswith("claude-") else "ollama — is it running?"
            print_err(f"Cannot reach {target}  ({e})")
        return "", ""

    except KeyboardInterrupt:
        _clear_spinner()
        if _ui:
            _ui.redraw()   # show whatever was streamed before the interrupt
        if not _ui and not silent:
            print(f"{R}")

    raw_text     = "".join(raw_parts)
    cleaned_text = re.sub(r"<think>.*?</think>", "", "\n".join(cleaned_lines),
                          flags=re.DOTALL).strip()
    # Strip non-Latin script characters (CJK, Arabic, etc.) that leak from model reasoning
    cleaned_text = re.sub(r"[\u0600-\u06FF\u0750-\u077F"   # Arabic
                          r"\u3000-\u9FFF"                  # CJK / Japanese / Korean
                          r"\uAC00-\uD7AF"                  # Hangul
                          r"\uF900-\uFAFF]+", "", cleaned_text)
    cleaned_text = re.sub(r"[ \t]+\n", "\n", cleaned_text).strip()

    # Store for Ctrl+B clipboard copy (non-silent calls only).
    # Clear _last_sources here so stale sources from a previous search don't
    # attach to a response that had no web search.  show_sources() will
    # re-populate it if this turn actually had sources.
    if not silent and cleaned_text:
        global _last_ai_response, _last_sources
        _last_ai_response = cleaned_text
        _last_sources     = []

    return raw_text, cleaned_text


# ── Model picker ───────────────────────────────────────────────────────────────

def _pick_model_curses(stdscr, models, current):
    """
    Full-screen interactive model picker.
    ↑↓ navigate · Enter select · q/Esc cancel.
    Returns chosen model name, or current if cancelled.
    """
    CP_HDR  = 2   # reuse TUI.CP_STATUS pair (white on blue)
    CP_CUR  = 8   # TUI.CP_CYAN + reverse for cursor row
    CP_NORM = 1   # TUI.CP_NORMAL
    CP_DIM  = 7   # TUI.CP_INFO
    CP_SEL  = 5   # TUI.CP_OK  (green) for current model
    CP_WARN = 9   # TUI.CP_WARN (yellow) for Claude API models

    # Start cursor on the currently active model
    try:
        cur = next(i for i, (n, _) in enumerate(models) if n == current)
    except StopIteration:
        cur = 0

    def draw():
        h, w = stdscr.getmaxyx()
        stdscr.erase()
        hdr = ("  MODEL SELECTOR  ·  ↑↓ navigate  ·  Enter select  ·  q back")
        try:
            stdscr.addstr(0, 0, hdr[:w - 1],
                          curses.color_pair(CP_HDR) | curses.A_BOLD)
        except curses.error:
            pass

        list_h = h - 3
        for i, (name, size) in enumerate(models):
            if i >= list_h:
                break
            is_cur     = (i == cur)
            is_current = (name == current)
            is_claude  = name.startswith("claude-")

            marker = "▶" if is_cur else " "
            tag    = "  (current)" if is_current else \
                     "  (default)" if name == DEFAULT_MODEL else ""
            line   = f"  {marker}  {name:<36} {size}{tag}"

            if is_cur:
                attr = curses.color_pair(CP_CUR) | curses.A_BOLD | curses.A_REVERSE
            elif is_current:
                attr = curses.color_pair(CP_SEL) | curses.A_BOLD
            elif is_claude:
                attr = curses.color_pair(CP_WARN)
            else:
                attr = curses.color_pair(CP_NORM)

            try:
                stdscr.addstr(i + 1, 0, line[:w - 1], attr)
            except curses.error:
                pass

        # Footer
        try:
            stdscr.addstr(h - 2, 0, "─" * (w - 1),
                          curses.color_pair(CP_DIM) | curses.A_DIM)
            note = ("  ⚠  Claude API models bill your Anthropic account"
                    if any(n.startswith("claude-") for n, _ in models) else "")
            stdscr.addstr(h - 1, 0, (f"  {len(models)} models available" + note)[:w - 1],
                          curses.color_pair(CP_DIM) | curses.A_DIM)
        except curses.error:
            pass

        stdscr.noutrefresh()
        curses.doupdate()

    stdscr.keypad(True)
    curses.curs_set(0)
    draw()

    while True:
        ch = stdscr.getch()
        h, _ = stdscr.getmaxyx()
        list_h = h - 3

        if ch == curses.KEY_RESIZE:
            draw()

        elif ch in (ord('q'), ord('Q'), 27):
            curses.curs_set(1)
            return current

        elif ch == curses.KEY_UP:
            cur = max(0, cur - 1)
            draw()

        elif ch == curses.KEY_DOWN:
            cur = min(len(models) - 1, cur + 1)
            draw()

        elif ch in (curses.KEY_HOME, 1):
            cur = 0
            draw()

        elif ch in (curses.KEY_END, 5):
            cur = len(models) - 1
            draw()

        elif ch in (curses.KEY_ENTER, ord('\n'), ord('\r')):
            curses.curs_set(1)
            return models[cur][0]


def pick_model(current="", stdscr=None):
    models = get_models(force=True)   # user explicitly opened the picker — show current state
    if not models:
        return DEFAULT_MODEL

    if stdscr is not None:
        # Interactive curses picker
        chosen = _pick_model_curses(stdscr, models, current)
        if chosen == current:
            return current or DEFAULT_MODEL
    else:
        # Fallback: plain-text numbered list (one-shot / non-TUI mode)
        print_info("available models")
        print_info("")
        for i, (name, size) in enumerate(models, 1):
            tag = "  ← current" if name == current else \
                  "  ← default" if name == DEFAULT_MODEL and not current else ""
            print_info(f"  [{i}]  {name:<34} {size}{tag}")
        print_info("")
        try:
            raw = input(f"  select [1-{len(models)}] or enter to keep: ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return current or DEFAULT_MODEL
        if raw.isdigit() and 1 <= int(raw) <= len(models):
            chosen = models[int(raw) - 1][0]
        else:
            return current or DEFAULT_MODEL

    if chosen.startswith("claude-"):
        print_info("")
        print_info("⚠  Claude API selected — this model costs money per request.")
        print_info(f"   Model:  {chosen}")
        print_info("   Billed to your Anthropic account on every message.")
        print_info("")
        if _ui:
            answer = _ui.choose(("Yes, use Claude API", "No, cancel"), default=1)
        else:
            try:
                answer = "Yes, use Claude API" if input("  Approve? [y/N]: ").strip().lower() == "y" else "No"
            except (EOFError, KeyboardInterrupt):
                answer = "No"
        if not answer.startswith("Yes"):
            print_info("cancelled — keeping current model")
            return current or DEFAULT_MODEL
    return chosen


# ── Drag-and-drop detection ────────────────────────────────────────────────────

def detect_drop(text):
    """
    Detect a dragged file/folder path in user input.
    Returns (Path, remainder) or (None, original_text).
    """
    t = text.strip()

    m = re.match(r'^([\'"])(~?/.+?)\1(.*)$', t)
    if m:
        p = Path(m.group(2)).expanduser()
        if p.exists():
            return p, m.group(3).strip()

    if t.startswith('/') or t.startswith('~/') or t.startswith('~'):
        MARK  = "\x00"
        unesc = t.replace('\\ ', MARK)
        tokens = unesc.split(' ')
        for i in range(len(tokens), 0, -1):
            candidate = ' '.join(tokens[:i]).replace(MARK, ' ')
            remainder = ' '.join(tokens[i:]).replace(MARK, ' ').strip()
            p = Path(candidate).expanduser()
            if p.exists():
                return p, remainder

    return None, text


def dir_summary(path, max_items=60):
    try:
        all_items = sorted(path.iterdir(), key=lambda x: (x.is_file(), x.name.lower()))
    except PermissionError:
        return f"Directory: {path}\n(permission denied)"
    lines = [f"Directory: {path}", f"{len(all_items)} items\n"]
    for item in all_items[:max_items]:
        if item.is_file():
            try:    sz = f"{item.stat().st_size:,} bytes"
            except: sz = ""
            lines.append(f"  {item.name:<40} {sz}")
        else:
            lines.append(f"  {item.name}/")
    if len(all_items) > max_items:
        lines.append(f"  ... and {len(all_items) - max_items} more items")
    return "\n".join(lines)


