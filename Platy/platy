_FENCE_RE    = re.compile(r"^\s*```")
_SCRIPT_ST_RE = re.compile(r"^\s*SCRIPT_START\s*$")
_SCRIPT_EN_RE = re.compile(r"^\s*SCRIPT_END\s*$")
_FILENAME_RE  = re.compile(r"^\s*FILENAME\s*:\s*\S+\s*$")
_HEADER_STRIP_RE = re.compile(r"^#{1,6} ")
_BOLD_STRIP_RE   = re.compile(r"\*\*([^*]+)\*\*")
_ITALIC_STRIP_RE = re.compile(r"\*([^*]+)\*")
_CODE_STRIP_RE   = re.compile(r"`([^`]+)`")

def strip_line(line):
    """Strip markdown and platy control markers. Returns None to suppress line."""
    if _FENCE_RE.match(line):     return None
    if _SCRIPT_ST_RE.match(line): return None
    if _SCRIPT_EN_RE.match(line): return None
    if _FILENAME_RE.match(line):  return None
    line = _HEADER_STRIP_RE.sub("",    line)
    line = _BOLD_STRIP_RE.sub(r"\1",   line)
    line = _ITALIC_STRIP_RE.sub(r"\1", line)
    line = _CODE_STRIP_RE.sub(r"\1",   line)
    return line

_MD_INLINE_RE = re.compile(r'\*\*([^*\n]+)\*\*|`([^`\n]+)`')
_MD_HEADER_RE = re.compile(r'^(#{1,6})\s+(.*)')
_MD_HR_RE     = re.compile(r'^[-*_]{3,}\s*$')
_MD_BULLET_RE = re.compile(r'^(\s*)([-*])\s+(.*)')

def _parse_md_segs(line, default_cp):
    """
    Parse a line of markdown for TUI display.
    Returns (plain_text, cp, bold, segs_or_None).
    plain_text  — text with markers stripped (used for wrapping/storage).
    segs        — list of (text, cp, attrs) for inline rendering, or None for plain.
    """
    # Headers → bold cyan, strip the # prefix
    hm = _MD_HEADER_RE.match(line)
    if hm:
        text = hm.group(2).strip()
        return text, TUI.CP_CYAN, True, None

    # Horizontal rules → dim separator
    if _MD_HR_RE.match(line):
        return '─' * 40, TUI.CP_INFO, False, None

    # Bullet/list items → replace dash/asterisk with •
    bm = _MD_BULLET_RE.match(line)
    if bm:
        line = bm.group(1) + '• ' + bm.group(3)

    # No inline markdown — return as plain
    if not _MD_INLINE_RE.search(line):
        return line, default_cp, False, None

    # Build inline segments for **bold** and `code`
    segs = []
    pos  = 0
    plain_parts = []
    for m in _MD_INLINE_RE.finditer(line):
        before = line[pos:m.start()]
        if before:
            segs.append((before, default_cp, 0))
            plain_parts.append(before)
        if m.group(1) is not None:       # **bold**
            segs.append((m.group(1), default_cp, curses.A_BOLD))
            plain_parts.append(m.group(1))
        else:                            # `code`
            segs.append((m.group(2), TUI.CP_OK, 0))
            plain_parts.append(m.group(2))
        pos = m.end()
    if pos < len(line):
        tail = line[pos:]
        segs.append((tail, default_cp, 0))
        plain_parts.append(tail)

    plain = "".join(plain_parts)
    return plain, default_cp, False, segs

