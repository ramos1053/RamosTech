def read_file(path_str):
    path = Path(path_str).expanduser().resolve()
    if not path.exists():
        print_err(f"file not found: {path}"); return None
    if not path.is_file():
        print_err(f"not a regular file: {path}"); return None
    try:
        content = path.read_text(errors="replace")
        print_ok(f"read {path}  ({len(content):,} chars)")
        return str(path), content
    except PermissionError:
        print_err(f"permission denied: {path}"); return None

def write_file(path_str, content):
    path = Path(path_str).expanduser().resolve()
    print_info(f"write {len(content):,} chars to:  {path}")
    if _ui:
        answer = _ui.choose(("Yes", "No", "Add context"), default=1)
    else:
        try:
            answer = "Yes" if input("  confirm? [y/N]: ").strip().lower() == "y" else "No"
        except (EOFError, KeyboardInterrupt):
            print(); return False
    if answer == "No":
        print_info("cancelled"); return False
    if answer not in ("Yes", "No"):   # "Add context" returned typed text
        print_info(f"context noted: {answer}")
        content = f"# context: {answer}\n{content}"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
        print_ok(f"written → {path}")
        return True
    except PermissionError:
        print_err(f"permission denied: {path}"); return False
    except Exception as e:
        print_err(str(e)); return False


# ── Script extraction & validation ────────────────────────────────────────────

# Prefer whatever shellcheck is on PATH (e.g. Homebrew); fall back to the
# ~/bin/shellcheck location the README documents for users without a package manager.
SHELLCHECK       = shutil.which("shellcheck") or str(Path.home() / "bin" / "shellcheck")
MAX_FIX_ATTEMPTS = 3

def extract_script(response):
    """Pull script from AI response. Returns (script, type, filename) or (None,None,None)."""
    m = re.search(r"^SCRIPT_START\s*\n(.*?)\n^SCRIPT_END",
                  response, re.MULTILINE | re.DOTALL)
    if m:
        script = re.sub(r"^\s*```[a-zA-Z]*\s*$", "", m.group(1),
                        flags=re.MULTILINE).strip()
    else:
        lines = response.splitlines()
        start = None
        for i, line in enumerate(lines):
            if line.strip().startswith("#!/"):
                start = i; break
        if start is None:
            return None, None, None

        def _prose(line):
            s = line.strip()
            if not s: return False
            if re.match(r'^\d+[.)]\s', s): return True
            if re.match(r'^[-*]\s+[A-Z]', s): return True
            if re.match(r'^[A-Z][a-z]', s) and not any(
                    c in s for c in '$=|;&{}()[]<>/\\'):
                return True
            return False

        script_lines = []
        for i, line in enumerate(lines[start:], start):
            if re.match(r"^\s*FILENAME\s*:",    line, re.IGNORECASE): break
            if re.match(r"^\s*SCRIPT_END\s*$",  line, re.IGNORECASE): break
            if re.match(r"^\s*Option\s+\d+\s*:", line, re.IGNORECASE): break
            if i > start and line.strip().startswith("#!/"):            break
            if re.match(r"^\s*```", line):                              continue
            if i > start and _prose(line):                              break
            script_lines.append(line)
        while script_lines and not script_lines[-1].strip():
            script_lines.pop()
        script = "\n".join(script_lines)

    if not script.strip():
        return None, None, None

    first_line = script.splitlines()[0] if script.splitlines() else ""
    if   "python"  in first_line: stype, ext = "python",     ".py"
    elif "ruby"    in first_line: stype, ext = "ruby",       ".rb"
    elif "perl"    in first_line: stype, ext = "perl",       ".pl"
    elif "node"    in first_line: stype, ext = "javascript", ".js"
    elif "swift"   in first_line: stype, ext = "swift",      ".swift"
    elif "zsh"     in first_line: stype, ext = "zsh",        ".zsh"
    elif "/sh"     in first_line: stype, ext = "sh",         ".sh"
    else:                         stype, ext = "bash",        ".sh"

    filename = None
    for line in response.splitlines():
        fm = re.search(r"FILENAME\s*:\s*(\S+)", line, re.IGNORECASE)
        if fm:
            candidate = fm.group(1)
            # Reject generic placeholder names the AI sometimes emits
            stem = re.sub(r'\.[^.]+$', '', candidate).lower()
            if stem not in ("script", "my-script", "test", "untitled", "output",
                            "descriptive-name", "your-script", "filename"):
                filename = candidate
            break
    if not filename:
        filename = _derive_filename(script, ext)

    return script, stype, filename


def _derive_filename(script, ext):
    """
    Derive a descriptive kebab-case filename from the script content.
    Looks for a leading comment after the shebang, falling back to the
    first non-trivial command word.
    """
    lines = script.splitlines()
    # Skip shebang, look for a comment on the next line(s)
    for line in lines[1:4]:
        line = line.strip()
        if line.startswith('#'):
            text = line.lstrip('#').strip()
            if 3 < len(text) <= 60:  # skip long prose / echoed-query comments
                slug = re.sub(r'[^\w\s-]', '', text.lower())
                slug = re.sub(r'[\s_]+', '-', slug).strip('-')
                slug = slug[:40].rstrip('-')
                if slug:
                    return slug + ext
    # Fall back to first meaningful command token
    for line in lines:
        line = line.strip()
        if line and not line.startswith('#') and not line.startswith('set '):
            token = re.split(r'[\s(]', line)[0]
            token = re.sub(r'[^\w-]', '', token)
            if len(token) > 2:
                return token[:30] + ext
    return f"unnamed{ext}"


def validate_script(script, stype):
    """Run validators on a script. Returns list of error strings (empty = clean)."""
    errors = []
    ext_map = {"python": ".py", "ruby": ".rb", "perl": ".pl",
               "javascript": ".js", "swift": ".swift", "zsh": ".zsh"}
    suffix = ext_map.get(stype, ".sh")

    with tempfile.NamedTemporaryFile(mode="w", suffix=suffix, delete=False) as f:
        f.write(script); tmp = f.name

    def _run(cmd, label):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        except subprocess.TimeoutExpired:
            errors.append(f"{label}: timed out after 10s — skipped")
            return
        out = (r.stdout + r.stderr).strip().replace(tmp, "script")
        if r.returncode != 0 and out:
            errors.append(f"{label}:\n{out}")

    try:
        if stype in ("bash", "sh"):
            shell = "bash" if stype == "bash" else "sh"
            _run([shell, "-n", tmp], f"{shell} -n (syntax)")
            if stype == "bash" and Path(SHELLCHECK).exists():
                try:
                    r = subprocess.run(
                        [SHELLCHECK, "--shell=bash", "--format=gcc", tmp],
                        capture_output=True, text=True, timeout=10)
                    if r.returncode != 0:
                        errors.append("shellcheck:\n" +
                                      r.stdout.strip().replace(tmp, "script"))
                except subprocess.TimeoutExpired:
                    errors.append("shellcheck: timed out after 10s — skipped")
        elif stype == "zsh":
            _run(["zsh", "-n", tmp], "zsh -n (syntax)")
        elif stype == "python":
            _run(["python3", "-m", "py_compile", tmp], "python syntax")
        elif stype == "ruby":
            _run(["ruby", "-c", tmp], "ruby syntax")
        elif stype == "perl":
            _run(["perl", "-c", tmp], "perl syntax")
        # swift / javascript: no fast checker available
    finally:
        Path(tmp).unlink(missing_ok=True)

    return errors


def offer_save(script, suggested):
    """Prompt to save a validated script. Offers chmod +x for shebang scripts."""
    default_path = Path.home() / "Desktop" / suggested
    print_info(f"script ready  ·  {len(script.splitlines())} lines")
    print_info(f"  [enter]  save to Desktop as  {suggested}")
    print_info("  [path ]  type a different destination")
    print_info("  [n    ]  skip")

    if _ui:
        raw = (_ui.prompt(">") or "").strip()
    else:
        try:
            raw = input("  > ").strip()
        except (EOFError, KeyboardInterrupt):
            print(); return

    if raw.lower() == "n":
        print_info("not saved"); return

    # Sanity-check: reject inputs that look like prose rather than a file path
    if raw and (len(raw) > 120 or (raw.count(' ') > 4 and not raw.startswith('/'))):
        print_err("that doesn't look like a file path — skipping save")
        print_info("use /write <path> to save manually")
        return

    p = default_path if not raw else (
        Path(raw).expanduser() if Path(raw).expanduser().is_absolute()
        else Path.home() / "Desktop" / raw
    )
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(script + "\n")
        print_ok(f"saved → {p}")
    except PermissionError:
        print_err(f"permission denied: {p}"); return
    except Exception as e:
        print_err(str(e)); return

    first = script.splitlines()[0] if script.splitlines() else ""
    if first.startswith("#!"):
        if _ui:
            yn = _ui.choose(("Yes, make executable", "No"), default=0)
        else:
            try:
                yn = "Yes" if input("  make executable? [Y/n]: ").strip().lower() != "n" else "No"
            except (EOFError, KeyboardInterrupt):
                yn = "No"
        if yn.startswith("Yes"):
            p.chmod(p.stat().st_mode | stat.S_IXUSR)
            print_ok(f"chmod +x {p}")


# ── Session persistence ────────────────────────────────────────────────────────

def _load_memory():
    global _memory, _learned
    try:
        if MEMORY_FILE.exists():
            data = json.loads(MEMORY_FILE.read_text())
            # Support both old flat format and new sectioned format
            if "pinned" in data or "learned" in data:
                _memory  = data.get("pinned",  {})
                _learned = data.get("learned", {})
            else:
                _memory  = data   # legacy flat file
                _learned = {}
    except Exception as e:
        _memory = {}; _learned = {}
        # Non-fatal — warn after UI is ready (stored as a deferred print)
        import warnings
        warnings.warn(f"platy: could not load memory file — {e}", stacklevel=2)

def _save_memory_file():
    """Atomically write memory to disk. Uses a temp file to avoid corruption."""
    tmp = MEMORY_FILE.with_suffix(".tmp")
    try:
        tmp.write_text(json.dumps({"pinned": _memory, "learned": _learned}, indent=2))
        os.chmod(tmp, 0o600)   # personal facts — owner-only, survives the rename below
        tmp.replace(MEMORY_FILE)
    except Exception as e:
        if _ui:
            _ui.add(f"  warning: memory not saved — {e}", TUI.CP_ERR)
        try:
            tmp.unlink(missing_ok=True)
        except Exception:
            pass

def _pin_fact(text):
    """Add a fact to persistent memory."""
    key = hashlib.md5(text.encode()).hexdigest()[:8]
    _memory[key] = text.strip()
    _save_memory_file()
    return key

def _learn_fact(text, source="explicit"):
    """Store a learned correction or taught fact."""
    key = hashlib.md5(text.encode()).hexdigest()[:8]
    _learned[key] = {"fact": text.strip(), "source": source,
                     "ts": int(time.time())}
    _save_memory_file()
    return key

def _forget_fact(key_or_text):
    """Remove a fact from pinned memory or learned memory."""
    removed = []
    needle = key_or_text.lower()
    for store in (_memory, _learned):
        for k in list(store):
            val = store[k]
            text = val["fact"] if isinstance(val, dict) else val
            if k.startswith(key_or_text) or text.lower() == needle:
                removed.append(text)
                del store[k]
    if removed:
        _save_memory_file()
    return removed

def _relative_time(ts):
    """Return human-friendly relative time string from a Unix timestamp."""
    diff = time.time() - ts
    if diff < 60:          return "just now"
    if diff < 3600:        return f"{int(diff/60)}m ago"
    if diff < 86400:       return f"{int(diff/3600)}h ago"
    if diff < 86400 * 2:   return "yesterday"
    if diff < 86400 * 7:   return f"{int(diff/86400)}d ago"
    return datetime.fromtimestamp(ts).strftime("%b %-d")

def _meta_path(sess_path):
    return Path(str(sess_path).replace(".jsonl", ".meta.json"))

def _save_session_meta(sess_path, label=None):
    """Persist the session label; 'last updated' is tracked via the meta
    file's own mtime rather than a stored field (see _load_session_meta)."""
    mp = _meta_path(sess_path)
    if not label:
        # Hot path — called on every message via save_turn(). Just bump
        # mtime instead of a read-parse-rewrite of the whole file.
        try:
            if mp.exists():
                os.utime(mp, None)
            else:
                mp.write_text("{}")
        except Exception:
            pass
        return
    try:
        meta = json.loads(mp.read_text()) if mp.exists() else {}
    except Exception:
        meta = {}
    meta["label"] = label
    tmp = mp.with_suffix(".tmp")
    try:
        tmp.write_text(json.dumps(meta))
        tmp.replace(mp)
    except Exception:
        try:
            tmp.unlink(missing_ok=True)
        except Exception:
            pass

def _load_session_meta(sess_path):
    """Returns (label, updated_ts) or ('', mtime)."""
    mp = _meta_path(sess_path)
    try:
        meta = json.loads(mp.read_text())
        return meta.get("label", ""), mp.stat().st_mtime
    except Exception:
        try:
            return "", sess_path.stat().st_mtime
        except Exception:
            return "", 0.0

def _generate_session_label(messages):
    """Generate a ≤5-word label from the first user message via delegate."""
    for m in messages:
        if m.get("role") == "user":
            content = m["content"][:200]
            task = f"Summarise this in 5 words or fewer, title-case, no punctuation: {content}"
            label = _run_delegate(task)
            # Strip quotes, truncate to 5 words
            label = label.strip().strip('"\'')
            words = label.split()[:5]
            return " ".join(words)
    return ""

SESSION_TTL_DAYS = 14

def _prune_old_sessions():
    """Delete sessions (and their .meta.json) not updated in SESSION_TTL_DAYS. Runs in background."""
    cutoff = time.time() - SESSION_TTL_DAYS * 86400
    try:
        for p in list(SESS_DIR.iterdir()):
            if p.suffix != ".jsonl":
                continue
            try:
                _, updated = _load_session_meta(p)
                if updated < cutoff:
                    p.unlink(missing_ok=True)
                    _meta_path(p).unlink(missing_ok=True)
            except Exception:
                pass
    except Exception:
        pass

def new_session(base="session"):
    name = f"{base}--{datetime.now().strftime('%Y-%m-%d-%H-%M-%S')}"
    path = SESS_DIR / f"{name}.jsonl"
    path.touch()
    return name, path

def save_turn(path, role, content):
    try:
        with open(path, "a") as f:
            f.write(json.dumps({"role": role, "content": content}) + "\n")
            f.flush()   # buffered write is enough for a chat log; skip fsync's disk-sync cost
    except OSError as e:
        if _ui:
            _ui.add(f"  warning: session not saved — {e}", TUI.CP_ERR)
    _save_session_meta(path)   # keep updated timestamp current

def load_session_messages(name):
    """Load all messages from a session file. Skips corrupted lines silently."""
    jl = (SESS_DIR / f"{name}.jsonl").resolve()
    if not jl.is_relative_to(SESS_DIR.resolve()):
        return None, None   # reject names that escape the sessions directory
    if not jl.exists():
        return None, None
    msgs = []
    with open(jl) as f:
        for line in f:
            line = line.strip()
            if line:
                try:
                    msgs.append(json.loads(line))
                except json.JSONDecodeError:
                    pass   # skip any corrupted line rather than crashing
    return name, msgs


# ── Conversation summarization ────────────────────────────────────────────────

def _maybe_summarize(messages, threshold=24):
    """If conversation exceeds threshold turns, summarize the oldest half."""
    user_turns = [m for m in messages if m["role"] in ("user", "assistant")]
    if len(user_turns) < threshold:
        return messages
    system = [m for m in messages if m["role"] == "system"]
    convo  = [m for m in messages if m["role"] != "system"]
    half   = len(convo) // 2
    to_summarize = convo[:half]
    keep         = convo[half:]
    blob = "\n".join(f"{m['role'].upper()}: {m['content'][:300]}" for m in to_summarize)
    summary = _run_delegate(
        f"Summarize this conversation segment in 3-5 sentences, preserving key facts "
        f"and decisions:\n\n{blob}"
    )
    summary_msg = {"role": "user",
                   "content": f"[Earlier conversation summary: {summary}]"}
    return system + [summary_msg] + keep

# ── Reminder / notification ────────────────────────────────────────────────────

_REMIND_RE = re.compile(
    r'remind me (?:in )?(\d+)\s*(min(?:ute)?s?|hour?s?|sec(?:ond)?s?)\s+(?:to\s+)?(.+)',
    re.IGNORECASE
)

def _schedule_reminder(text):
    """Parse 'remind me in X minutes to Y' and fire a macOS notification."""
    m = _REMIND_RE.search(text)
    if not m:
        return False
    amount, unit, task = int(m.group(1)), m.group(2).lower(), m.group(3).strip()
    if "sec" in unit:   delay = amount
    elif "hour" in unit: delay = amount * 3600
    else:               delay = amount * 60

    # Escape backslashes and double quotes so the task text cannot break out
    # of the AppleScript string and inject arbitrary commands.
    safe_task = task.replace("\\", "\\\\").replace('"', '\\"')
    script = (f'delay {delay}\n'
              f'display notification "{safe_task}" with title "platy reminder" '
              f'sound name "Ping"')
    threading.Thread(
        target=lambda: subprocess.run(["osascript", "-e", script],
                                      capture_output=True),
        daemon=True
    ).start()
    return True

# ── File watcher ───────────────────────────────────────────────────────────────

def _start_watch(path_str, messages, sess_path):
    """Watch a file and inject changes into context when it updates."""
    p = Path(path_str).expanduser().resolve()
    if not p.exists():
        return False
    _watched_files[str(p)] = p.stat().st_mtime

    def _watch_loop():
        consecutive_errors = 0
        while str(p) in _watched_files:
            time.sleep(2)
            try:
                mtime = p.stat().st_mtime
                if mtime != _watched_files.get(str(p)):
                    _watched_files[str(p)] = mtime
                    content = p.read_text(errors="replace")[:4000]
                    inject  = f"[file updated: {p.name}]\n\n{content}"
                    messages.append({"role": "user", "content": inject})
                    save_turn(sess_path, "user", inject)
                    if _ui:
                        _ui.add(f"  ⟳ {p.name} changed — injected into context",
                                TUI.CP_CYAN)
                        _ui.redraw()
                consecutive_errors = 0
            except FileNotFoundError:
                # File was deleted — stop watching silently
                _watched_files.pop(str(p), None)
                break
            except Exception:
                consecutive_errors += 1
                if consecutive_errors >= 5:
                    # Persistent failure — give up
                    _watched_files.pop(str(p), None)
                    break
    threading.Thread(target=_watch_loop, daemon=True).start()
    return True

