            try:
                for p in sorted(SESS_DIR.iterdir(), key=lambda x: x.stat().st_mtime, reverse=True):
                    if p.suffix != ".jsonl":
                        continue
                    try:
                        text = p.read_text()
                        if not query or query.lower() in text.lower():
                            label, updated = _load_session_meta(p)
                            hits.append((label or p.stem, _relative_time(updated), p.stem))
                    except Exception:
                        continue
            finally:
                if _ui:
                    _ui.spin_stop()
            if not hits:
                print_info("no matching sessions found")
            else:
                print_info(f"  {'label':<38}  {'when':<12}  session id")
                for label, rel, stem in hits[:15]:
                    print_info(f"  {label:<38}  {rel:<12}  {stem}")
                print_info("  use /load <session id> to resume")
