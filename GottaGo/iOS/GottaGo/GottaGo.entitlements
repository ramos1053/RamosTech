<plist version="1.0">
<dict>
	<!-- iCloud Key-Value Storage: requires a paid Apple Developer account.
	     To enable:
	     1. Sign in to developer.apple.com → Identifiers
	     2. Register explicit App ID: com.gottago.app
	     3. Edit it → enable "iCloud" → check "iCloud Key-Value Storage"
	     4. Save. Xcode Automatic signing will regenerate the provisioning profile.
	     5. Uncomment the two lines below and rebuild.
	-->
